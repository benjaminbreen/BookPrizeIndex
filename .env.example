# Affiliate identifiers are public tracking values, not secrets. Leave any value
# blank until the corresponding retailer or affiliate network approves the site.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=ro067-20
NEXT_PUBLIC_BOOKSHOP_AFFILIATE_ID=

# Impact, Rakuten Advertising, Skimlinks, or another approved network will provide
# retailer-specific deep-link URLs. Use {url} where the encoded destination belongs.
NEXT_PUBLIC_BARNES_NOBLE_AFFILIATE_URL_TEMPLATE=
NEXT_PUBLIC_KOBO_AFFILIATE_URL_TEMPLATE=
NEXT_PUBLIC_THRIFTBOOKS_AFFILIATE_URL_TEMPLATE=

# Canonical production URL used when returning stable shared-list links.
NEXT_PUBLIC_SITE_URL=https://bookprizeindex.com

# Added automatically when a Vercel Blob store is connected to the project.
# Local development uses .semantic-lists/ and .personal-lists/ when this value is absent.
BLOB_READ_WRITE_TOKEN=
