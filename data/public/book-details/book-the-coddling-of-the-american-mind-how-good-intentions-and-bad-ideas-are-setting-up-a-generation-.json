erId":"publisher-penguin-random-house","readerProfile":{"readerLevel":"popular","narrativeScore":0.099,"accessibilityScore":0.733,"scholarlyScore":0,"traits":[{"id":"popular","score":0.916,"confidence":"high","evidence":["catalog text contains \"popular\"","catalog text contains \"bestseller\"","catalog text contains \"new york times bestseller\"","trade publisher signal: Penguin Press / Penguin Random House","major-award recognition"]},{"id":"accessible","score":0.86,"confidence":"high","evidence":["catalog text contains \"popular\"","catalog text contains \"bestseller\"","catalog text contains \"new york times bestseller\"","trade publisher signal: Penguin Press / Penguin Random House"]},{"id":"reported","score":0.34,"confidence":"low","evidence":["journalism/reportage subject or topic"]},{"id":"character_driven","score":0.18,"confidence":"low","evidence":["catalog text contains \"family\""]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":78,"criticalRenown":57,"controversy":73,"llmAffinity":58,"affinityResidual":-28.26,"confidence":{"publicFame":0.98,"criticalRenown":0.88,"controversy":0.96,"llmAffinity":0.98},"tags":{"craft":"craft-of-explanation","evidence":"synthesis-of-scholarship","stance":"counterintuition"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":true,"statement":"Three harmful beliefs embedded in American childhood and education undermine healthy development and contribute to campus conflict and a culture of safetyism.","confidence":0.96},"academicOrientation":{"score":34,"confidence":0.94},"profileConfidence":0.95,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"America","confidence":0.58}]},"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"9651fc3e15de721e99bfc77038758841edc6f1b6560cb358810f9f9b3a146606","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Society & Culture","secondarySubjects":["Politics & Government"],"confidence":"high","rationale":"The book predominantly addresses the cultural and societal shifts on college campuses, relating them to broader issues of political polarization and psychological well-being.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"397af36fe256676ce6893abeecaf4fbcefcca9160f8953a4580bed8fb97c3374","summary":"\"Something is going wrong on many college campuses in the last few years. Rates of anxiety, depression, and suicide are rising. Speakers are shouted down. Students and professors say they are walking on eggshells and afraid to speak honestly. How did this happen? First Amendment expert Greg Lukianoff and social psychologist Jonathan Haidt show how the new problems on campus have their origins in three terrible ideas that have become increasingly woven into American childhood and education: what doesn't kill you makes you weaker; always trust your feelings; and life is a battle between good people and evil people. These three Great Untruths are incompatible with basic psychological principles, as well as ancient wisdom from many cultures. They interfere with healthy development. Anyone who embraces these untruths--and the resulting culture of safetyism--is less likely to become an autonomous adult able to navigate the bumpy road of life. Lukianoff and Haidt investigate the many social trends that have intersected to produce these untruths. They situate the conflicts on campus in the context of America's rapidly rising political polarization, including a rise in hate crimes and off-campus provocation.","displaySummary":"Rates of anxiety, depression, and suicide are rising. Speakers are shouted down. Students and professors say they are walking on eggshells and afraid to speak honestly. How did this happen? First Amendment expert Greg Lukianoff and social psychologist Jonathan Haidt show how the new problems on campus have their origins in three terrible ideas that have become increasingly woven into American childhood and education: what doesn't kill you makes you weaker; always trust your feelings; and life is a battle between good people and evil people. These three Great Untruths are incompatible with basic psychological principles, as well as ancient wisdom from many cultures. They interfere with healthy development. Anyone who embraces these untruths--and the resulting culture of safetyism--is less likely to become an autonomous adult able to navigate the bumpy road of life. Lukianoff and Haidt investigate the many social trends that have intersected to produce these untruths. They situate the conflicts on campus in the context of America's rapidly rising political polarization, including a rise in hate crimes and off-campus provocation.","primaryTopic":"Class, Poverty & Inequality","subjectEvidence":{"primarySubject":"Society & Culture","confidence":"high","method":"evidence_score","candidates":[{"subject":"Society & Culture","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"Society & Culture","mappedSubject":"Society & Culture","score":8,"confidence":"high","note":"The book predominantly addresses the cultural and societal shifts on college campuses, relating them to broader issues of political polarization and psychological well-being.","id":"subject-evidence-book-the-coddling-of-the-american-mind-how-good-intentions-and-bad-ideas-are-setting-up-a-generation--1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Social psychology","mappedSubject":"Medicine & Public Health","score":6,"confidence":"high","sourceId":"source-open-library-summary-the-coddling-of-the-american-mind-how-good-intentions-and-bad-ideas-are-setting-up-a-generation-","id":"subject-evidence-book-the-coddling-of-the-american-mind-how-good-intentions-and-bad-ideas-are-setting-up-a-generation--6"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Psychology","mappedSubject":"Medicine & Public H