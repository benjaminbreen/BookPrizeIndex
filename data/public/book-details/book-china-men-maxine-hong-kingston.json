er-1981-winner","bookId":"book-china-men-maxine-hong-kingston","awardId":"award-national-book-award-for-general-nonfiction-hardcover","awardEditionId":"edition-national-book-award-for-general-nonfiction-hardcover-1981","year":1981,"status":"winner","originalStatus":"winner","statusRank":1,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Award_for_Nonfiction","sourceIds":["source-award-record-national-book-awards-general-nonfiction-hardcover-wikipedia-national-book-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Award for General Nonfiction Hardcover","slug":"national-book-award-for-general-nonfiction-hardcover"},"statusLabel":"Winner"},{"id":"appearance-china-men-maxine-hong-kingston-pulitzer-prize-in-general-nonfiction-1981-finalist","bookId":"book-china-men-maxine-hong-kingston","awardId":"award-pulitzer-prize-in-general-nonfiction","awardEditionId":"edition-pulitzer-prize-in-general-nonfiction-1981","year":1981,"status":"finalist","originalStatus":"finalist","statusRank":2,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/Pulitzer_Prize_for_General_Nonfiction","sourceIds":["source-award-record-pulitzer-general-nonfiction-wikipedia-pulitzer-prize-for-general-nonfiction"],"award":{"awardType":"major_award","name":"Pulitzer Prize in General Nonfiction","slug":"pulitzer-prize-in-general-nonfiction"},"statusLabel":"Finalist"},{"id":"appearance-china-men-maxine-hong-kingston-national-book-critics-circle-award-for-nonfiction-1980-finalist","bookId":"book-china-men-maxine-hong-kingston","awardId":"award-national-book-critics-circle-award-for-nonfiction","awardEditionId":"edition-national-book-critics-circle-award-for-nonfiction-1980","year":1980,"status":"finalist","originalStatus":"finalist","statusRank":2,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Nonfiction","sourceIds":["source-award-record-nbcc-nonfiction-wikipedia-national-book-critics-circle-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Critics Circle Award for Nonfiction","slug":"national-book-critics-circle-award-for-nonfiction"},"statusLabel":"Finalist"}],"imprint":"Knopf","publisher":"Penguin Random House","stats":{"bookId":"book-china-men-maxine-hong-kingston","wins":1,"lists":3,"score":18,"majorWins":1,"normalWins":0,"majorShortlists":2,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":1,"co_winner":0,"finalist":2,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-china-men-maxine-hong-kingston","pageTitle":"China Men","pageId":30286426,"wikidataId":"Q5099777","url":"https://en.wikipedia.org/wiki/China_Men","revisionId":1346102185,"accessedAt":"2026-05-18T21:16:03.977Z","extract":"China Men is a 1980 collection of \"stories\" by Maxine Hong Kingston. It is a sequel to The Woman Warrior with a focus on the history of the men in Kingston's family. It won the 1981 National Book Award for Nonfiction. Kingston wrote The Woman Warrior and China Men as one and would like them to be read together; she decided to publish them separately in fear that some of the men's stories might weaken the feminist perspective of the women's stories. The collection becomes what A. Robert Lee calls a \"narrative genealogy\" of Chinese settlement in the United States. To tell their stories, many of which Kingston heard only through the talk-story of the women in her family, she mixes the known history of her family with hypothetical imaginings and with the legal history of Chinese America. Her book presents a picture of a United States still changing in its reciprocal influence with China. At the same time, the title reflects a deliberate rejection of American racism against the Chinese: whereas the term \"Chinaman\" was a common slur (such as in John Chinaman), the Chinese referred to themselves as the \"China Men\" of the title: tang jen (Chinese: 唐人; pinyin: Tángrén; Jyutping: tong4 jan4). Some of the main characters in the book include Kingston's great-grandfather Bak Goong, who worked on the sugar plantations in Hawaii; her grandfather Ah Goong, who worked for the railroad construction companies; her father BaBa, a gambling house owner and laundryman; and her unnamed brother, who receives no honor for fighting for the US in Vietnam. These characters are at times presented more as archetypes than as individuals, and at times there are competing versions of the story, as if the characters represent all the possible forefathers of the Chinese American population; as Elaine H. Kim points out, the father character \"immigrates to America in five different ways, by way of Cuba, Angel Island, or Ellis Island [...] He could have entered the country legally, or he could have come as a paper son or by some other avenue. He is both 'the father from China' and 'the American father.'\"","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/China_Men","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"China Men","author":"Maxine Hong Kingston","publisher":"Alfred A. Knopf","publicationDate":"1980","publicationPlace":"United States","pages":"308","isbn":"0-394-42463-8","language":"English","genre":"short-story cycle"},"publisherEvidenceId":"publisher-evidence-wikipedia-china-men-maxine-hong-kingston"},"sources":[{"id":"source-award-record-national-book-awards-general-nonfiction-hardcover-wikipedia-national-book-award-for-nonfiction","label":"Wikipedia: National Book Award for Nonfiction","url":"https://en.wikipedia.org/wiki/National_Book_Award_for_Nonfiction","accessedAt":"2026-08-03T18:18:44.813Z","confidence":"secondary","field":"award","note":"Official archive URL: https://www.nationalbook.org/national-book-awards/search/"},{"id":"source-award-record-nbcc-nonfiction-wikipedia-national-book-cr