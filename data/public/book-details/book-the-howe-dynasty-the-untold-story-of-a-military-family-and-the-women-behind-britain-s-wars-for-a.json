iveScore":0.132,"accessibilityScore":0.019,"scholarlyScore":0,"traits":[{"id":"character_driven","score":0.18,"confidence":"low","evidence":["catalog text contains \"family\""]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":24,"criticalRenown":57,"controversy":8,"llmAffinity":67,"affinityResidual":-6.13,"confidence":{"publicFame":0.86,"criticalRenown":0.78,"controversy":0.74,"llmAffinity":0.86},"tags":{"craft":"narrative-drive","evidence":"archival-research","stance":"revisionism"},"model":"gpt-5.6-luna","promptVersion":1},"summary":"\"Finally revealing the family's indefatigable women among its legendary military figures, The Howe Dynasty recasts the British side of the American Revolution. In December 1774, Benjamin Franklin met Caroline Howe, the sister of British Admiral Richard and General William Howe, in a London drawing room for \"half a dozen Games of Chess.\" As Julie Flavell reveals, the games concealed a matter of the utmost diplomatic urgency, a last-ditch attempt to forestall the outbreak of war. Aware that the Howes, both the men and the women, have seemed impenetrable to historians, Flavell investigated the letters of Caroline Howe, which have been overlooked for centuries. Using these revelatory documents, Flavell provides a compelling reinterpretation of England's famous family across four wars, centering on their enigmatic roles in the American Revolution.","subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"New York Times reviewed","sourceId":"source-open-library-summary-the-howe-dynasty-the-untold-story-of-a-military-family-and-the-women-behind-britain-s-wars-for-a"},{"source":"open_library","scheme":"open_library_subject","label":"Great britain, history","sourceId":"source-open-library-summary-the-howe-dynasty-the-untold-story-of-a-military-family-and-the-women-behind-britain-s-wars-for-a"},{"source":"open_library","scheme":"open_library_subject","label":"Forei