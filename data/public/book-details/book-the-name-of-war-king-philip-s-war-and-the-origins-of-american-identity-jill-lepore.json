":0,"accessibilityScore":0.154,"scholarlyScore":0.074,"traits":[{"id":"popular","score":0.34,"confidence":"low","evidence":["trade publisher signal: Knopf / Penguin Random House","major-award recognition"]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":58,"criticalRenown":87,"controversy":24,"llmAffinity":88,"affinityResidual":6.6,"confidence":{"publicFame":0.96,"criticalRenown":0.97,"controversy":0.9,"llmAffinity":0.98},"tags":{"craft":"prose-style","evidence":"archival-research","stance":"revisionism"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[{"name":"Philip","confidence":0.98}],"centralPlaces":[{"name":"New England","confidence":0.95},{"name":"Plymouth","confidence":0.82}],"argument":{"present":true,"statement":"The brutality of King Philip’s War transformed previously blurred cultural boundaries between colonists and Indians into rigid divisions.","confidence":0.96},"academicOrientation":{"score":45,"confidence":0.84},"profileConfidence":0.94,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"Narragansett Bay","confidence":0.62}]},"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"93e72c68e0eb5cd4f4824e5515eacb37d0e487ae645883623c0a0e0b2690c4ee","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"American History","secondarySubjects":["War & Military","Race & Ethnicity"],"confidence":"high","rationale":"The book primarily examines King Philip's War within the context of American history, focusing on its implications for race relations and violence between colonists and Native Americans.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"9e86055b9b885fdd77b398fcac77c9766a4029709c087125561a9fb3ddd617cb","summary":"Winner of the the 1998 Ralph Waldo Emerson Award of the Phi Beta Kappa Society King Philip's War, the excruciating racial war--colonists against Indians--that erupted in New England in 1675, was, in proportion to population, the bloodiest in American history. Some even argued that the massacres and outrages on both sides were too horrific to \"deserve the name of a war.\"It all began when Philip (called Metacom by his own people), the leader of the Wampanoag Indians, led attacks against English towns in the colony of Plymouth. The war spread quickly, pitting a loose confederation of southeastern Algonquians against a coalition of English colonists. While it raged, colonial armies pursued enemy Indians through the swamps and woods of New England, and Indians attacked English farms and towns from Narragansett Bay to the Connecticut River Valley. Both sides, in fact, had pursued the war seemingly without restraint, killing women and children, torturing captives, and mutilating the dead. The fighting ended after Philip was shot, quartered, and beheaded in August 1676.The war's brutality compelled the colonists to defend themselves against accusations that they had become savages. But Jill Lepore makes clear that it was after the war--and because of it--that the boundaries between cultures, hitherto blurred, turned into rigid ones.","publicationYear":1998,"subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Politics and government","sourceId":"source-open-library-summary-the-name-of-war-king-philip-s-war-and-the-origins-of-american-identity-jill-lepore"},{"source":"open_library","scheme":"open_library_subject","label":"Indians of North America","sourceId":"source-open-library-summary-the-name-of-war-king-philip-s-war-and-the-origins-of-american-identity-jill-lepore"},{"source":"open_library","scheme":"open_library_subject","label":"Wars","sourceId":"source-open-library-summary-the-name-of-war-king-philip-s-war-and-the-origins-of-american-identity-jill-lepore"},{"source":"open_library","scheme":"open_library_subject","label":"Great Britain","sourceId":"source-open-library-summary-the-name-of-war-king-philip-s-war-and-the-origins-of-ameri