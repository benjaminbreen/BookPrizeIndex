cademic press signal: Oxford University Press / Oxford University Press"]},{"id":"synthesis","score":0.26,"confidence":"low","evidence":["catalog text contains \"from\"","catalog text contains \"overview\""]},{"id":"argument_driven","score":0.2,"confidence":"low","evidence":["catalog text contains \"demonstrates\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":true,"statement":"Monetary union impaired European integration rather than enhancing it, because the European project’s economic weaknesses and integration tensions were baked in from the beginning and inconsistencies were papered over.","confidence":0.66},"academicOrientation":{"score":78,"confidence":0.55},"profileConfidence":0.68,"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"ab47b60fb1cfcb0781b175c7c123b202684ab477c03b617a307db3d065118be9","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Business & Economics","secondarySubjects":["History","Politics & Government"],"confidence":"high","rationale":"The book primarily analyzes the economic integration of Europe and the implications of the Euro, situating it within the broader context of business economics, while also addressing historical and political factors.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"6c1d0ac76f54e9574d80e1259e095acf7d13ade2ac58b2ea5717915737f99355","summary":"\"The promise of the European pursuit of ever closer union created tremendous optimism that conflict was the past and harmony would be the future. The enthusiasm for economic integration and monetary union, through the Euro, enhanced the confidence that differences among countries could be overcome. In this dynamic and incisive overview of the European project from its beginnings, Ashoka Mody convincingly demonstrates that the tensions and flaws of the European project were both baked-in and foreseen from the beginning. He focuses on personalities whose ambitious and relentless push for integration led them to choose facts and analysis consistent with their visions and to dismiss warnings of turbulence. They thus laid the seeds for disappointment. Mody examines key moments when contradictions were papered-over, compromising the integrity of integration. He shows how political and economic leaders believed the stories they told themselves about the inevitability of a united Europe as a foundation of peace, prosperity, and democratic ideals, even in the face of warnings from the earliest stages that while the political pillars seemed strong, the economic foundations were weak. Mody compellingly shows how monetary union impaired European integration rather than enhanced it.","publicationYear":2018,"subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Europe, economic integration","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Europe, economic conditions","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Economic integration","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"History","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Economic conditions","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"BUSINESS & ECONOMICS","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"International","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Economics","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Macroeconomics","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Economic history","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"International economic integration","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Mitgliedsstaaten","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Euro","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Integration","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Schwachstellenanalyse","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Wirtschaftliche Integration","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"},{"source":"open_library","scheme":"open_library_subject","label":"Europäische Union","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody"}],"displaySummary":"The enthusiasm for economic integration and monetary union, through the Euro, enhanced the confidence that differences among countries could be overcome. In this dynamic and incisive overview of the European project from its beginnings, Ashoka Mody convincingly demonstrates that the tensions and flaws of the European project were both baked-in and foreseen from the beginning. He focuses on personalities whose ambitious and relentless push for integration led them to choose facts and analysis consistent with their visions and to dismiss warnings of turbulence. They thus laid the seeds for disappointment. Mody examines key moments when contradictions were papered-over, compromising the integrity of integration. He shows how political and economic leaders believed the stories they told themselves about the inevitability of a united Europe as a foundation of peace, prosperity, and democratic ideals, even in the face of warnings from the earliest stages that while the political pillars seemed strong, the economic foundations were weak. Mody compellingly shows how monetary union impaired European integration rather than enhanced it.","primaryTopic":"Business, Capitalism & Corporations","subjectEvidence":{"primarySubject":"Business & Economics","confidence":"high","method":"evidence_score","candidates":[{"subject":"Business & Economics","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"Business & Economics","mappedSubject":"Business & Economics","score":8,"confidence":"high","note":"The book primarily analyzes the economic integration of Europe and the implications of the Euro, situating it within the broader context of business economics, while also addressing historical and political factors.","id":"subject-evidence-book-eurotragedy-ashoka-mody-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"BUSINESS & ECONOMICS","mappedSubject":"Business & Economics","score":5,"confidence":"high","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody","id":"subject-evidence-book-eurotragedy-ashoka-mody-7"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Economics","mappedSubject":"Business & Economics","score":5,"confidence":"high","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody","id":"subject-evidence-book-eurotragedy-ashoka-mody-8"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Macroeconomics","mappedSubject":"Business & Economics","score":5,"confidence":"high","sourceId":"source-open-library-summary-eurotragedy-ashoka-mody","id":"sub