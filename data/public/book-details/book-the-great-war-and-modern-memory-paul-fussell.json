":["source-award-record-national-book-awards-nonfiction-wikipedia-national-book-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Award for Nonfiction","slug":"national-book-award-for-nonfiction"},"statusLabel":"Co-winner"},{"id":"appearance-the-great-war-and-modern-memory-paul-fussell-phi-beta-kappa-book-awards-ralph-waldo-emerson-award-1976-winner","bookId":"book-the-great-war-and-modern-memory-paul-fussell","awardId":"award-phi-beta-kappa-book-awards-ralph-waldo-emerson-award","awardEditionId":"edition-phi-beta-kappa-book-awards-ralph-waldo-emerson-award-1976","year":1976,"status":"winner","originalStatus":"winner","statusRank":1,"isTie":false,"sourceUrl":"https://www.pbk.org/awards/bookawards/emerson-winners","sourceIds":["source-award-record-pbk-emerson-phi-beta-kappa-ralph-waldo-emerson-award-winners"],"award":{"awardType":"award","name":"Phi Beta Kappa Book Awards: Ralph Waldo Emerson Award","slug":"phi-beta-kappa-book-awards-ralph-waldo-emerson-award"},"statusLabel":"Winner"},{"id":"appearance-the-great-war-and-modern-memory-paul-fussell-national-book-critics-circle-award-for-criticism-1975-winner","bookId":"book-the-great-war-and-modern-memory-paul-fussell","awardId":"award-national-book-critics-circle-award-for-criticism","awardEditionId":"edition-national-book-critics-circle-award-for-criticism-1975","year":1975,"status":"winner","originalStatus":"winner","statusRank":1,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Criticism","sourceIds":["source-award-record-nbcc-criticism-wikipedia-national-book-critics-circle-award-for-criticism"],"award":{"awardType":"major_award","name":"National Book Critics Circle Award for Criticism","slug":"national-book-critics-circle-award-for-criticism"},"statusLabel":"Winner"}],"imprint":"Oxford University Press","publisher":"Oxford University Press","stats":{"bookId":"book-the-great-war-and-modern-memory-paul-fussell","wins":3,"lists":3,"score":24,"majorWins":2,"normalWins":1,"majorShortlists":0,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":2,"co_winner":1,"finalist":0,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-the-great-war-and-modern-memory-paul-fussell","pageTitle":"The Great War and Modern Memory","pageId":34865681,"wikidataId":"Q4117225","url":"https://en.wikipedia.org/wiki/The_Great_War_and_Modern_Memory","revisionId":1322560817,"accessedAt":"2026-05-18T21:16:03.977Z","extract":"The Great War and Modern Memory is a book of literary criticism written by Paul Fussell and published in 1975 by Oxford University Press. It describes the literary responses by English participants in World War I to their experiences of combat, particularly in trench warfare. Fussell describes how the collective experience of the \"Great War\" was correlated with, and to some extent underlain by, an enduring shift in the worldview of individuals, from the tropes that had guided writers before the war to the harsher themes that came to be dominant during the war and after. Fussell's criticism crosses genre boundaries, attempting to describe how the experience of the war forced them to share a common atmosphere in their essays, letters home, novels, humor, and poetry. The work of Northrop Frye is a powerful influence on Fussell's analysis of how the experience of the war altered the way they and their peers responded to the prewar world. Fussell later commented: Also, I was very interested in the Great War, as it was called then, because it was the initial twentieth-century shock to European culture. By the time we got to the Second World War, everybody was more or less used to Europe being badly treated and people being killed in multitudes. The Great War introduced those themes to Western culture, and therefore it was an immense intellectual and cultural and social shock. In The Great War and Modern Memory, Fussell describes the lives and works of many figures, with extended passages treating four English writers who saw combat on the Western front: Edmund Blunden, Robert Graves, Wilfred Owen, and Siegfried Sassoon. The experiences of trench warfare not only affected what these and other authors wrote during the conflict, but (if they survived the war) shaped their output for the remainders of their lives. He cites mid-20th century authors like Norman Mailer and Thomas Pynchon abundantly, demonstrating that World War I has continued to shape the literary imagination.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/The_Great_War_and_Modern_Memory","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"The Great War and Modern Memory","author":"Paul Fussell","publisher":"Oxford University Press","publicationDate":"1975","publicationPlace":"United States","isbn":"0-19-513331-5","language":"English","genre":"Literary criticism"},"publisherEvidenceId":"publisher-evidence-wikipedia-the-great-war-and-modern-memory-paul-fussell"},"sources":[{"id":"source-award-record-national-book-awards-nonfiction-wikipedia-national-book-award-for-nonfiction","label":"Wikipedia: National Book Award for Nonfiction","url":"https://en.wikipedia.org/wiki/National_Book_Award_for_Nonfiction","accessedAt":"2026-07-30T20:00:35.708Z","confidence":"secondary","field":"award","note":"Official archive URL: https://www.nationalbook.org/national-book-awards/search/ Imported table: National Book Award for Nonfiction winners and finalists, 2020–2029"},{"id":"source-award-record-nbcc-criticism-wikipedia-national-book-critics-circle-award-for-criticism","label":"Wikipedia: National Book Critics Circle Award for Criticism","url":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Criticism","accessedAt":"2026-07-30T20:00:35.708Z","confidence":"secondary","field":"award","n