{"book":{"id":"book-lavoisier-the-crucial-year-the-background-and-origin-of-his-first-experiments-on-combustion-in-1","slug":"lavoisier-the-crucial-year-the-background-and-origin-of-his-first-experiments-on-combustion-in-1","title":"Lavoisier, The Crucial Year: The Background and Origin of His First Experiments on Combustion in 1772","authors":[{"id":"person-henry-guerlac","name":"Henry Guerlac"}],"isbn13":["9782881244049"],"subjects":["Science"],"topics":["Business, Capitalism & Corporations","Labor, Work & Organizing"],"centralFigures":["Antoine-Laurent Lavoisier"],"links":{"amazon":"https://www.amazon.com/s?k=Lavoisier%2C%20The%20Crucial%20Year%3A%20The%20Background%20and%20Origin%20of%20His%20First%20Experiments%20on%20Combustion%20in%201772%20Henry%20Guerlac","bookshop":"https://bookshop.org/search?keywords=Lavoisier%2C%20The%20Crucial%20Year%3A%20The%20Background%20and%20Origin%20of%20His%20First%20Experiments%20on%20Combustion%20in%201772%20Henry%20Guerlac","indiebound":"https://www.indiebound.org/search/book?keys=Lavoisier%2C%20The%20Crucial%20Year%3A%20The%20Background%20and%20Origin%20of%20His%20First%20Experiments%20on%20Combustion%20in%201772%20Henry%20Guerlac","worldcat":"https://search.worldcat.org/search?q=Lavoisier%2C%20The%20Crucial%20Year%3A%20The%20Background%20and%20Origin%20of%20His%20First%20Experiments%20on%20Combustion%20in%201772%20Henry%20Guerlac","publisher":"https://books.google.com/books/about/Lavoisier_the_Crucial_Year.html?hl=&id=yGu2wAEACAAJ"},"sourceIds":["source-award-record-pfizer-history-of-science-wikipedia-pfizer-award-recipients","source-google-books-lavoisier-the-crucial-year-the-background-and-origin-of-his-first-experiments-on-combustion-in-1","source-open-library-lavoisier-the-crucial-year-the-background-and-origin-of-his-first-experiments-on-combustion-in-1","source-cover-open-library-lavoisier-the-crucial-year-the-background-and-origin-of-his-first-experiments-on-combustion-in-1"],"subjectCategories":[{"source":"google_bo