.046,"scholarlyScore":0,"traits":[{"id":"essayistic","score":1,"confidence":"high","evidence":["catalog text contains \"essay\"","catalog text contains \"essays\"","catalog text contains \"criticism\"","literature/criticism subject or topic"]},{"id":"narrative","score":0.38,"confidence":"low","evidence":["catalog text contains \"story of\"","catalog text contains \"chronicles the\""]},{"id":"synthesis","score":0.2,"confidence":"low","evidence":["catalog text contains \"from\"","catalog text contains \"history of\""]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":22,"criticalRenown":68,"controversy":8,"llmAffinity":72,"affinityResidual":-0.65,"confidence":{"publicFame":0.86,"criticalRenown":0.82,"controversy":0.78,"llmAffinity":0.86},"tags":{"craft":"craft-of-explanation","evidence":"archival-research","stance":"revisionism"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[{"name":"Song Yingxing","confidence":0.98}],"centralPlaces":[{"name":"China","confidence":0.95},{"name":"southern China","confidence":0.78}],"argument":{"present":true,"statement":"Song Yingxing transformed practical knowledge into written culture, revealing how seventeenth-century Chinese technical writing shaped approaches to rationality, truth, and belief.","confidence":0.9},"academicOrientation":{"score":76,"confidence":0.9},"profileConfidence":0.94,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"fe1c60ef370049caec82ea287e52af9ae6e0376e1f10b73328207738b5bb151a","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"The last decades of the Ming dynasty, though plagued by chaos and destruction, saw a significant increase of publications that examined advances in knowledge and technology. Among the numerous guides and reference books that appeared during this period was a series of texts by Song Yingxing (1587–1666?), a minor local official living in southern China. His Tiangong kaiwu, the longest and most prominent of these works, documents the extraction and processing of raw materials and the manufacture of goods essential to everyday life, from yeast and wine to paper and ink to boats, carts, and firearms. In The Crafting of the 10,000 Things, Dagmar Schäfer probes this fascinating text and the legacy of its author to shed new light on the development of scientific thinking in China, the purpose of technical writing, and its role in and effects on Chinese history. Meticulously unfolding the layers of Song’s personal and cultural life, Schäfer chronicles the factors that motivated Song to transform practical knowledge into written culture. She then examines how Song gained, assessed, and ultimately presented knowledge, and in doing so articulates this era’s approaches to rationality, truth, and belief in the study of nature and culture alike.","displaySummary":"The last decades of the Ming dynasty, though plagued by chaos and destruction, saw a significant increase of publications that examined advances in knowledge and technology. Among the numerous guides and reference books that appeared during this period was a series of texts by Song Yingxing (1587–1666?), a minor local official living in southern China. His Tiangong kaiwu, the longest and most prominent of these works, documents the extraction and processing of raw materials and the manufacture of goods essential to everyday life, from yeast and wine to paper and ink to boats, carts, and firearms. In The Crafting of the 10,000 Things, Dagmar Schäfer probes this fascinating text and the legacy of its author to shed new light on the development of scientific thinking in China, the purpose of technical writing, and its role in and effects on Chinese history. Meticulously unfolding the layers of Song’s personal and cultural life, Schäfer chronicles the factors that motivated Song to transform practical knowledge into written culture. She then examines how Song gained, assessed, and ultimately presented knowledge, and in doing so articulates this era’s approaches to rationality, truth, and belief in the study of nature and culture alike.","primarySubject":"Science","primaryTopic":"Technology, Computing & AI","subjectEvidence":{"primarySubject":"Science","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Science","score":18,"evidenceCount":3},{"subject":"Technology","score":6,"evidenceCount":1},{"subject":"History","score":3,"evidenceCount":1}],"evidence":[{"source":"open_library","scheme":"open_library_subject","rawLabel":"Science","mappedSubject":"Science","score":6,"confidence":"high","sourceId":"source-open-library-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s","id":"subject-evidence-book-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Science, china","mappedSubject":"Science","score":6,"confidence":"high","sourceId":"source-open-library-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s","id":"subject-evidence-book-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s-4"},{"source":"google_books","scheme":"google_books_category","rawLabel":"Science","mappedSubject":"Science","score":6,"confidence":"high","sourceId":"source-google-books-summary-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s","id":"subject-evidence-book-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s-5"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Technology","mappedSubject":"Technology","score":6,"confidence":"high","sourceId":"source-open-library-the-crafting-of-the-10-000-things-knowledge-and-technology-in-seventeenth-century-china-dagmar-s","id":"subject-evidence-book-the-crafting-of-t