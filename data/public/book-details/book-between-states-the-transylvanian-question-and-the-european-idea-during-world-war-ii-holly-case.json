cOrientation":{"score":70,"confidence":0.55},"profileConfidence":0.78,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"World War II","confidence":0.4}]},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"8bd505f356e57e5ae5b06b4c31f76c64bdea96e38e156fe880b20d4cd5bdfa30","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"World History","secondarySubjects":["History","Politics & Government"],"confidence":"high","rationale":"The book focuses on the Transylvanian Question during World War II, exploring its implications on European politics and state interactions, which fits predominantly under World History.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"eabb3ae34464f45ab8142536c78af36e96f889fd2d41f986f77503bd72938409","summary":"Winner of the 2010 George Louis Beer Prize of the American Historical Association. The struggle between Hungary and Romania for control of Transylvania seems at first sight a side-show in the story of the Nazi New Order and the Second World War. These allies of the Third Reich spent much of the war arguing bitterly over Transylvania's future, and Germany and Italy were drawn into their dispute to prevent it from spiraling into a regional war. But precisely as a result of this interaction, the story of the Transylvanian Question offers a new way into the history of how state leaders and national elites have interpreted what \"Europe\" means. Tucked into the folds of the Transylvanian Question's bizarre genealogy is a secret that no one ever tried to keep, but that has remained a secret nonetheless: small states matter. The perspective of small states puts the struggle for mastery among its Great Powers into a new perspective.","pageCount":384,"publicationYear":2009,"subjectCategories":[{"source":"google_books","scheme":"google_books_category","label":"History","sourceId":"source-google-books-summary-between-states-the-transylvanian-question-and-the-european-idea-during-world-war-ii-holly-case"}],"displaySummary":"The struggle between Hungary and Romania for control of Transylvania seems at first sight a side-show in the story of the Nazi New Order and the Second World War. These allies of the Third Reich spent much of the war arguing bitterly over Transylvania's future, and Germany and Italy were drawn into their dispute to prevent it from spiraling into a regional war. But precisely as a result of this interaction, the story of the Transylvanian Question offers a new way into the history of how state leaders and national elites have interpreted what \"Europe\" means. Tucked into the folds of the Transylvanian Question's bizarre genealogy is a secret that no one ever tried to keep, but that has remained a secret nonetheless: small states matter. The perspective of small states puts the struggle for mastery among its Great Powers into a new perspective.","primaryTopic":"World War II","subjectEvidence":{"primarySubject":"World History","confidence":"medium","method":"evidence_score","candidates":[{"subject":"World History","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"World History","mappedSubject":"World History","score":8,"confidence":"high","note":"The book focuses on the Transylvanian Question during World War II, exploring its implications on European politics and state interactions, which fits predominantly under World History.","id":"subject-evidence-book-between-states-the-transylvanian-question-and-the-european-idea-during-world-war-ii-holly-case-1"},{"source":"google_books","scheme":"google_books_category","rawLabel":"History","mappedSubject":"History","score":3,"confidence":"medium","sourceId":"source-google-books-summary-between-states-the-transylvanian-question-and-the-european-idea-during-world-war-ii-holly-case","id":"subject-evidence-book-between-states-the-transylvanian-question-and-the-european-idea-during-world-war-ii-holly-case-4"},{"source":"award_category","rawLabel":"American Histor