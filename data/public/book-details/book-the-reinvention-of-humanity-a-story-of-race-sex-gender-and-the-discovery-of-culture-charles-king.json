ilityScore":0.143,"scholarlyScore":0,"traits":[{"id":"narrative","score":0.87,"confidence":"high","evidence":["catalog text contains \"story of\"","catalog text contains \"tells the story\"","catalog text contains \"journey\"","catalog text contains \"scandal\""]},{"id":"character_driven","score":0.18,"confidence":"low","evidence":["catalog text contains \"family\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[{"name":"Margaret Mead","confidence":0.75}],"centralPlaces":[],"argument":{"present":true,"statement":"By documenting diverse cultural practices of love, child-rearing, family structure, and gender roles, the anthropologists challenged scientific consensus that race or sex determines intelligence and ability, showing social roles are shaped by culture rather than biology.","confidence":0.62},"academicOrientation":{"score":52,"confidence":0.35},"profileConfidence":0.58,"lowerConfidenceCandidates":{"centralFigures":[{"name":"Ruth Benedict","confidence":0.6}],"centralPlaces":[{"name":"Haiti","confidence":0.45},{"name":"Japan","confidence":0.4},{"name":"the Arctic","confidence":0.38}]},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"8403b8619094768a3dfc333817f299885b62d2724d6c6ee35c9e14ea35266dcc","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Race & Ethnicity","secondarySubjects":["Gender & Sexuality","Society & Culture"],"confidence":"high","rationale":"The book primarily focuses on the anthropological study of race, gender, and culture, highlighting the impact of diverse human experiences on societal norms.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"813a86ea8779f98c3684f0c319ca2d02e6abe9e1e47c98e0647b86589c8e4ad4","summary":"\"The Reinvention of Humanity tells the story of a small circle of renegade scientist-explorers who changed something profound: what it means to be normal. In the early twentieth century, these pioneering anthropologists, many of them women, made intrepid journeys that overturned our assumptions about race, sexuality, gender and the nature of human diversity, paving the way for the civil rights movements that followed and sparking a debate that continues to this day. From the Arctic to the South Pacific, from Haiti to Japan, they immersed themselves in distant or isolated communities, where they observed and documented radically different approaches to love and child-rearing, family structure and the relationship between women and men. With this evidence they were able to challenge the eras scientific consensus and deep-rooted Western belief that intelligence, ability and character are determined by a persons race or sex, and show that the roles people play in society are shaped in fact according to the immense variety of human cultures. Theirs were boundary-breaking lives, filled with scandal, romance, rivalry and tragedy. Those of Margaret Mead and her essential partner Ruth Benedict resulted in fame and notoriety.","publicationYear":2019,"subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Anthropology","sourceId":"source-open-library-summary-the-reinvention-of-humanity-a-story-of-race-sex-gender-and-the-discovery-of-culture-charles-king"},{"source":"open_library","scheme":"open_library_subject","label":"Anthropology, research","sourceId":"source-open-library-summary-the-reinvention-of-humanity-a-story-of-race-sex-gender-and-the-discovery-of-culture-charles-king"},{"source":"open_library","scheme":"open_library_subject","label":"Anthropologists","sourceId":"source-open-library-summary-the-reinvention-of-humanity-a-story-of-race-sex-gender-and-the-discovery-of-culture-charles-king"},{"source":"open_library","scheme":"open_library_subject","label":"Biography","sourceId":"source-open-library-summary-the-reinvention-of-humanity-a-story-of-race-sex-gender-and-the-discovery-of-culture-charles-king"},{"source":"open_library","scheme":"open_lib