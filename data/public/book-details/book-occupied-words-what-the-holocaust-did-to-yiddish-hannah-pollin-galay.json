Renown":69,"controversy":12,"llmAffinity":86,"affinityResidual":14.32,"confidence":{"publicFame":0.86,"criticalRenown":0.72,"controversy":0.62,"llmAffinity":0.89},"tags":{"craft":"craft-of-explanation","evidence":"interviews-fieldwork","stance":"moral-seriousness"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":true,"statement":"The Holocaust radically altered Yiddish, as prisoners created new words and phrases to express experiences that prewar language could not describe.","confidence":0.98},"academicOrientation":{"score":73,"confidence":0.91},"profileConfidence":0.94,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"fe742964a5d9303207b53c6fa196546b72389ef1fc09a34a0ecc3a42820e04dd","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"How Yiddish changed to express and memorialize the trauma of the Holocaust The Holocaust radically altered the way many East European Jews spoke Yiddish. Finding prewar language incapable of describing the imprisonment, death, and dehumanization of the Shoah, prisoners added or reinvented thousands of Yiddish words and phrases to describe their new reality. These crass, witty, and sometimes beautiful Yiddish words – Khurbn Yiddish, or “Yiddish of the Holocaust” – puzzled and intrigued the East European Jews who were experiencing the metamorphosis of their own tongue in real time. Sensing that Khurbn Yiddish words harbored profound truths about what Jews endured during the Holocaust, some Yiddish speakers threw themselves into compiling dictionaries and glossaries to document and analyze these new words. Others incorporated Khurbn Yiddish into their poetry and prose. In Occupied Words, Hannah Pollin-Galay explores Khurbn Yiddish as a form of Holocaust memory and as a testament to the sensation of speech under genocidal conditions. Occupied Words investigates Khurbn Yiddish through the lenses of cultural history, philology, and literary interpretation.","pageCount":313,"publicationYear":2024,"subjectCategories":[{"source":"google_books","scheme":"google_books_category","label":"Social Science","sourceId":"source-google-books-summary-occupied-words-what-the-holocaust-did-to-yiddish-hannah-pollin-galay"}],"displaySummary":"In Occupied Words, Hannah Pollin-Galay explores Khurbn Yiddish as a form of Holocaust memory and as a testament to the sensation of speech under genocidal conditions. Occupied Words investigates Khurbn Yiddish through the lenses of cultural history, philology, and literary interpretation.","primarySubject":"Society & Culture","primaryTopic":"Holocaust","subjectEvidence":{"primarySubject":"Society & Culture","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Society & Culture","score":5,"evidenceCount":1}],"evidence":[{"source":"google_books","scheme":"google_books_category","rawLabel":"Social Science","mappedSubject":"Society & Culture","score":5,"confidence":"high","sourceId":"source-google-books-summary-occupied-words-what-the-holocaust-did-to-yiddish-hannah-pollin-galay","id":"subject-evidence-book-occupied-words-what-the-holocaust-did-to-yiddish-hannah-pollin-galay-1"},{"source":"keyword_classifier","rawLabel":"Arts & Criticism","mappedSubject":"Arts & Criticism","score":2,"confidence":"low","note":"history keyword or history prize; war/military keyword; arts/criticism keyword; religion keyword","id":"subject-evidence-book-occupied-words-what-the-holocaust-did-to-yiddish-hannah-pollin-galay-2"},{"source":"keyword_classifier","rawLabel":"Religion","mappedSubject":"Religion","score":2,"confidence":"low","note":"history keyword or history prize; war/military keyword; arts/criticism keyword; religion keyword","id":"subject-evidence-book-occupied-words-what-the-holocaust-did-to-yiddish-hannah-pollin-galay-3"},{"source":"keyword_classifier","rawLabel":"War & Military","mappedSubject":"War & Military","score":2,"confidence":"low","note":"history keyword or hist