kId":"book-lenin-s-tomb-the-last-days-of-the-soviet-empire-david-remnick","awardId":"award-national-book-critics-circle-award-for-nonfiction","awardEditionId":"edition-national-book-critics-circle-award-for-nonfiction-1993","year":1993,"status":"finalist","originalStatus":"finalist","statusRank":2,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Nonfiction","sourceIds":["source-award-record-nbcc-nonfiction-wikipedia-national-book-critics-circle-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Critics Circle Award for Nonfiction","slug":"national-book-critics-circle-award-for-nonfiction"},"statusLabel":"Finalist"}],"imprint":"Random House","publisher":"Penguin Random House","stats":{"bookId":"book-lenin-s-tomb-the-last-days-of-the-soviet-empire-david-remnick","wins":3,"lists":4,"score":22,"majorWins":1,"normalWins":2,"majorShortlists":1,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":3,"co_winner":0,"finalist":1,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-lenin-s-tomb-the-last-days-of-the-soviet-empire-david-remnick","pageTitle":"Lenin's Tomb: The Last Days of the Soviet Empire","pageId":3698327,"wikidataId":"Q139621931","url":"https://en.wikipedia.org/wiki/Lenin's_Tomb%3A_The_Last_Days_of_the_Soviet_Empire","revisionId":1350976627,"accessedAt":"2026-05-18T21:16:03.977Z","extract":"Lenin's Tomb: The Last Days of the Soviet Empire is a book by American author David Remnick. Often cited as an example of New Journalism, it won the Pulitzer Prize for General Nonfiction in 1994. The book is equal parts history and eyewitness account, covering the collapse of the Soviet Union. Opening with the excavation of the corpses of Poles killed in the Katyn massacre, Lenin's Tomb begins by describing the structural flaws present from the country's early days, and then uses individual accounts from a wide variety of contemporary individuals to display the modern consequences of these historical errors and cruelties. Within the book, Remnick draws heavily on his past work as Moscow correspondent with The Washington Post. In addition to officials and public figures, current and former—one chapter in part recounts Remnick's attempts to interview Lazar Kaganovich, of Joseph Stalin's inner circle—he takes advantage of a wide variety of \"everyman\"-type sources. These individuals, while not themselves notable, help add richness and texture to Remnick's depiction of the world around them. In 1997, Remnick published a follow-up work, Resurrection, dealing with the creation of a new Russian state. The book was the required reading for the University Interscholastic League's Social Studies Competition in 2018. Jay Nordlinger gave a favorable assessment of the book.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/Lenin's_Tomb%3A_The_Last_Days_of_the_Soviet_Empire","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"author":"David Remnick","publisher":"Random House","publicationDate":"1993","genre":"Non-fiction }}"},"publisherEvidenceId":"publisher-evidence-wikipedia-lenin-s-tomb-the-last-days-of-the-soviet-empire-david-remnick"},"sources":[{"id":"source-award-record-george-polk-book-long-island-university-official-george-polk-award-winners-archive","label":"Long Island University official George Polk Award winners archive","url":"https://www.liu.edu/polk-awards/past-winners","accessedAt":"2026-08-03T18:18:44.813Z","confidence":"official","field":"award"},{"id":"source-award-record-helen-bernstein-journalism-wikipedia-helen-bernstein-book-award-for-excellence-in-journalism","label":"Wikipedia: Helen Bernstein Book Award for Excellence in Journalism","url":"https://en.wikipedia.org/wiki/Helen_Bernstein_Book_Award_for_Excellence_in_Journalism","acce