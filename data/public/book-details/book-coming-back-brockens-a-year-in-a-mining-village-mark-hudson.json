vidence":["trade publisher signal: Jonathan Cape / Penguin Random House"]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":24,"criticalRenown":55,"controversy":3,"llmAffinity":63,"affinityResidual":-10.13,"confidence":{"publicFame":0.75,"criticalRenown":0.7,"controversy":0.65,"llmAffinity":0.65},"tags":{"craft":"prose-style","evidence":"personal-experience","stance":"elegy"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[{"name":"Horden","confidence":0.99},{"name":"Durham","confidence":0.82}],"argument":{"present":true,"statement":"The closure of the pit destroyed a mining world, leaving Horden alive chiefly through the memories of its older residents and exposing the failures of what replaced it.","confidence":0.88},"academicOrientation":{"score":28,"confidence":0.93},"profileConfidence":0.96,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"Britain","confidence":0.42}]},"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"5e97dd87fa54c74b730d0a5dcf9cea053538e2cfd169250205d4a8dba546e05f","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"A few years ago Mark Hudson went to live in Horden, a mining village on the bleak east coast of Durham. Horden had been the biggest colliery in Britain and among the men who had worked there were Mark Hudson's great grandfather and grandfather. The pit has now closed and Horden remains alive only in the memories of its old people. In search of his forebears Mark Hudson listens to tales of how it was of the hardships and traditions of the miner's life, of the struggles and triumphs of the union. And tales too of his ancestors, but these are curiously fickle: they flicker and fluctuate; the only certainty is the pit. COMING BACK BROCKENS is a brilliant portrait of a world that has gone for ever, an angry indictment of what has taken its place, and a search for personal meaning in the past.","publicationYea