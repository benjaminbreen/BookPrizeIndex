st-fact-crime","awardEditionId":"edition-edgar-awards-best-fact-crime-2008","year":2008,"status":"winner","originalStatus":"winner","statusRank":1,"isTie":false,"sourceUrl":"https://edgarawards.com/category-list-best-fact-crime/?instance=1&listpage=1","sourceIds":["source-award-record-edgar-best-fact-crime-edgar-awards-official-best-fact-crime-database"],"award":{"awardType":"award","name":"Edgar Awards: Best Fact Crime","slug":"edgar-awards-best-fact-crime"},"statusLabel":"Winner"}],"imprint":"W. W. Norton","publisher":"W. W. Norton & Company","stats":{"bookId":"book-reclaiming-history-the-assassination-of-president-john-f-kennedy-vincent-bugliosi","wins":1,"lists":1,"score":4,"majorWins":0,"normalWins":1,"majorShortlists":0,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":1,"co_winner":0,"finalist":0,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-reclaiming-history-the-assassination-of-president-john-f-kennedy-vincent-bugliosi","pageTitle":"Reclaiming History","pageId":11731106,"wikidataId":"Q7302565","url":"https://en.wikipedia.org/wiki/Reclaiming_History","revisionId":1363584467,"accessedAt":"2026-08-03T19:00:12.125Z","extract":"Reclaiming History: The Assassination of President John F. Kennedy is a 2007 book by attorney Vincent Bugliosi that analyzes the events surrounding the assassination of United States president John F. Kennedy, focusing on the lives of Lee Harvey Oswald and Jack Ruby. He drew from many sources, including the Warren Report. Bugliosi argues that the Warren Commission's conclusion that Lee Oswald acted alone in shooting Kennedy is correct. The book won the 2008 Edgar Award for the Best Fact Crime category. Bugliosi explored the issue at length as the book totals 1,632 pages. It was published with an accompanying CD-ROM containing an additional 1,000+ pages of footnotes. He analyzed both the assassination itself and the rise of the conspiracy theories about the event in the following years. In 2008, Bugliosi published a shorter paperback edition of this book, titled Four Days in November: The Assassination of President John F. Kennedy. It concentrated on the events of the assassination and aftermath. This version was adapted for the movie Parkland (2013). A second edition of his paperback was issued as Parkland (2013), to tie into the movie's release.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/Reclaiming_History","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"Reclaiming History: The Assassination of President John F. Kennedy","author":"Vincent Bugliosi","publisher":"W. W. Norton & Company","publicationDate":"May 15, 2007","publicationPlace":"United States","pages":"1,632 pp","isbn":"0-393-04525-0","language":"English","subject":"True crime, John F. Kennedy assassination, Lee Harvey Oswald, United States conspiracies"},"publisherEvidenceId":"publisher-evidence-wikipedia-reclaiming-history-the-assassination-of-president-john-f-kennedy-vincent-bugliosi"},"sources":[{"id":"source-award-record-edgar-best-fact-crime-edgar-awards-official-best-fact-crime-database","label":"Edgar Awards official Best Fact Crime database","url":"https://edgarawards.com/category-list-best-fact-crime/?instance=1&listpage=1","accessedAt":"2026-08-15T17:37:11.749Z","confidence":"official","field":"award","note":"Official award URL: https://edgarawards.com/category-list-best-fact-crime/"},{"id":"source-imprint-normalization","label":"Curated raw-publisher to imprint normalization","url":"","accessedAt":"2026-08-15T17:34:29.799Z","confidence":"manual","field":"publisher","note":"Curated mappings from raw catalog publisher strings to explicit imprint and parent-publisher records. Used by scripts/normalize-imprints.ts to generate sources/enrichment/imprints.normalized.json."},{"id":"source-o