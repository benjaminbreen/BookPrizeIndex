["catalog text contains \"essay\"","catalog text contains \"essays\"","catalog text contains \"criticism\"","literature/criticism subject or topic"]},{"id":"argument_driven","score":0.48,"confidence":"medium","evidence":["catalog text contains \"theory\"","intellectual history topic","scholarly subject/topic combination"]},{"id":"biographical","score":0.34,"confidence":"low","evidence":["biography subject or topic"]},{"id":"accessible","score":0.18,"confidence":"low","evidence":["catalog text contains \"vivid\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":true,"statement":"Darwin’s sexual selection was strategically crucial because it explained features natural selection could not and provided a naturalistic account of beauty and its perception.","confidence":0.74},"academicOrientation":{"score":70,"confidence":0.58},"profileConfidence":0.78,"lowerConfidenceCandidates":{"centralFigures":[{"name":"Darwin","confidence":0.62}]},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"f7aad596364fa40092897a85925ced565b8b18279e362bde814b15984019acd0","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"Darwin's concept of natural selection has been exhaustively studied, but his secondary evolutionary principle of sexual selection remains largely unexplored and misunderstood. Yet sexual selection was of great strategic importance to Darwin because it explained things that natural selection could not and offered a naturalistic, as opposed to divine, account of beauty and its perception. Only now, with Darwin and the Making of Sexual Selection, do we have a comprehensive and meticulously researched account of Darwin's path to its formulation - one that shows the man, rather than the myth, and examines both the social and intellectual roots of Darwin's theory. Drawing on the minutiae of his unpublished notes, annotations in his personal library, and his extensive correspondence, Evelleen Richards offers a richly detailed, multilayered history. Her fine-grained analysis comprehends the extraordinarily wide range of Darwin's sources and disentangles the complexity of theory, practice, and analogy that went into the making of sexual selection. Richards deftly explores the narrative strands of this history and vividly brings to life the chief characters involved.","subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Darwin, charles, 1809-1882","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards"},{"source":"open_library","scheme":"open_library_subject","label":"Sex preselection","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards"},{"source":"open_library","scheme":"open_library_subject","label":"Sexual selection","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards"},{"source":"open_library","scheme":"open_library_subject","label":"History","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards"},{"source":"open_library","scheme":"open_library_subject","label":"Sexuelle Selektion","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards"},{"source":"open_library","scheme":"open_library_subject","label":"Evolutionstheorie","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards"}],"displaySummary":"Darwin's concept of natural selection has been exhaustively studied, but his secondary evolutionary principle of sexual selection remains largely unexplored and misunderstood. Yet sexual selection was of great strategic importance to Darwin because it explained things that natural selection could not and offered a naturalistic, as opposed to divine, account of beauty and its perception. Only now, with Darwin and the Making of Sexual Selection, do we have a comprehensive and meticulously researched account of Darwin's path to its formulation - one that shows the man, rather than the myth, and examines both the social and intellectual roots of Darwin's theory. Drawing on the minutiae of his unpublished notes, annotations in his personal library, and his extensive correspondence, Evelleen Richards offers a richly detailed, multilayered history. Her fine-grained analysis comprehends the extraordinarily wide range of Darwin's sources and disentangles the complexity of theory, practice, and analogy that went into the making of sexual selection. Richards deftly explores the narrative strands of this history and vividly brings to life the chief characters involved.","primarySubject":"Biography","primaryTopic":"Science & Discovery","subjectEvidence":{"primarySubject":"Biography","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Biography","score":6,"evidenceCount":1},{"subject":"Science","score":6,"evidenceCount":1},{"subject":"History","score":3,"evidenceCount":1}],"evidence":[{"source":"open_library","scheme":"open_library_subject","rawLabel":"Darwin, charles, 1809-1882","mappedSubject":"Biography","score":6,"confidence":"high","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards","id":"subject-evidence-book-darwin-and-the-making-of-sexual-selection-evelleen-richards-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Evolutionstheorie","mappedSubject":"Science","score":6,"confidence":"high","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards","id":"subject-evidence-book-darwin-and-the-making-of-sexual-selection-evelleen-richards-3"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"History","mappedSubject":"History","score":3,"confidence":"medium","sourceId":"source-open-library-darwin-and-the-making-of-sexual-selection-evelleen-richards","id":"subject-evidence-book-darwin-and-the-making-of-sexual-se