-us-alan-weisman","awardId":"award-national-book-critics-circle-award-for-nonfiction","awardEditionId":"edition-national-book-critics-circle-award-for-nonfiction-2007","year":2007,"status":"finalist","originalStatus":"finalist","statusRank":2,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Nonfiction","sourceIds":["source-award-record-nbcc-nonfiction-wikipedia-national-book-critics-circle-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Critics Circle Award for Nonfiction","slug":"national-book-critics-circle-award-for-nonfiction"},"statusLabel":"Finalist"}],"stats":{"bookId":"book-the-world-without-us-alan-weisman","wins":0,"lists":1,"score":4,"majorWins":0,"normalWins":0,"majorShortlists":1,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":0,"co_winner":0,"finalist":1,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-the-world-without-us-alan-weisman","pageTitle":"The World Without Us","pageId":12395051,"wikidataId":"Q611356","url":"https://en.wikipedia.org/wiki/The_World_Without_Us","revisionId":1362236622,"accessedAt":"2026-08-03T19:00:12.125Z","extract":"The World Without Us is a 2007 non-fiction book about what would happen to the natural and built environment if humans suddenly disappeared, written by American journalist Alan Weisman and published by St. Martin's Thomas Dunne Books. It is a book-length expansion of Weisman's own February 2005 Discover article \"Earth Without People\". Written largely as a thought experiment, it outlines, for example, how cities and houses would deteriorate, how long man-made artifacts would last, and how remaining lifeforms would evolve. Weisman concludes that residential neighborhoods would become forests within 500 years, and that radioactive waste, bronze statues, plastics and Mount Rushmore would be among the longest-lasting evidence of human presence on Earth. The author of four previous books and numerous articles for magazines, Weisman had traveled to interview academics, scientists and other authorities. He used quotations from these interviews to explain the effects of the natural environment and to substantiate predictions. The book has been translated and published in many countries. It was successful in the U.S., reaching #6 on the New York Times Best Seller list and #1 on the San Francisco Chronicle Best-Sellers list in September 2007. It ranked #1 on Time and Entertainment Weekly's top 10 non-fiction books of 2007.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/The_World_Without_Us","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"The World Without Us","author":"Alan Weisman","publicationDate":"July 10, 2007 (St. Martin's Thomas Dunne Books)","publicationPlace":"United States","isbn":"978-0-312-34729-1","language":"English","genre":"Non-fiction"}},"sources":[{"id":"source-award-record-nbcc-nonfiction-wikipedia-national-book-critics-circle-award-for-nonfiction","label":"Wikipedia: National Book Critics Circle Award for Nonfiction","url":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Nonfiction","accessedAt":"2026-08-04T04:49:23.023Z","confidence":"secondary","field":"award","note":"Official awards URL: https://www.bookcritics.org/awards/"},{"id":"source-cover-open-library-the-world-without-us-alan-weisman","label":"Open Library cover for The World Without Us","url":"https://openlibrary.org/isbn/9780312347291","accessedAt":"2026-07-15T06:36:18.413Z","confidence":"catalog","field":"book","note":"Cover ID 7447787 recovered from cached Open Library catalog metadata."},{"id":"source-open-library-isbn-the-world-without-us-alan-weisman","label":"Open Library ISBN discovery for The World Without Us","url":"https://openlibrary.org/books/OL24096382