umbnailUrl":"https://books.google.com/books/content?id=o2U0AAAAMAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api","readerProfile":{"readerLevel":"academic","narrativeScore":0,"accessibilityScore":0,"scholarlyScore":0.539,"traits":[{"id":"scholarly","score":0.5,"confidence":"medium","evidence":["catalog text contains \"scholarly\"","meta-scholarly history-writing context"]},{"id":"academic","score":0.375,"confidence":"low","evidence":["catalog text contains \"scholarly\"","meta-scholarly history-writing context"]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":35,"criticalRenown":62,"controversy":2,"llmAffinity":78,"affinityResidual":2.19,"confidence":{"publicFame":0.93,"criticalRenown":0.88,"controversy":0.82,"llmAffinity":0.82},"tags":{"craft":"prose-style","evidence":"personal-experience","stance":"wonder"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[{"name":"America's Southwest","confidence":0.95},{"name":"Arizona desert","confidence":0.88}],"argument":{"present":true,"statement":"Intimate observation of desert life deepens understanding of humanity’s relationship with nature and the universe.","confidence":0.93},"academicOrientation":{"score":43,"confidence":0.86},"profileConfidence":0.95,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"d7f7fab9c31ddef014689a6b91e56ddfa409e5d7f012c1b7c90e09e8639d2754","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"W.D. Patterson, The Saturday Review: \"Thoreau had his New England pond; Joseph Wood Krutch, his Arizona desert. And in both cases the reader should be a happier, wiser and better person because of the books these two philosophers of nature wrote out of their intimate observation of their immediate environment. The Voice of the Desert is a memorable book not only about the violent extremes of life in the desert, but about man's own relation with nature and the universe.\" This book explores the rich, intriguing, unexpected variety of life in the desert of America's Southwest. It is both for lovers of natural history and for those who enjoy the ruminations of a wise mind. Thus the result of this adventure with the natural wonders of the desert is a joyful, wise and witty credo by a man who knows that the proper study of mankind extends to all of nature. The delightful book - scholarly and informed though it is - is first of all a product of the exuberant enthusiasm that only a convert can bring to his subject. Joseph Wood Krutch came to the desert in his middle years - a man of letters who had spent his entire adult life in the cities and countryside of the Northeast. He found that the desert was exactly right for him - that he was healthier and happier in its bright, dry air than ever before.","publicationYear":1952,"displaySummary":"The Voice of the Desert is a memorable book not only about the violent extremes of life in the desert, but about man's own relation with nature and the universe.\" This book explores the rich, intriguing, unexpected variety of life in the desert of America's Southwest. It is both for lovers of natural history and for those who enjoy the ruminations of a wise mind. Thus the result of this adventure with the natural wonders of the desert is a joyful, wise and witty credo by a man who knows that the proper study of mankind extends to all of nature. The delightful book - scholarly and informed though it is - is first of all a product of the exuberant enthusiasm that only a convert can bring to his subject. Joseph Wood Krutch came to the desert in his middle years - a man of letters who had spent his entire adult life in the cities and countryside of the Northeast. He found that the desert was exactly right for him - that he was healthier and happier in its bright, dry air than ever before.","primarySubject":"Nature & Environment","primaryTopic":"Natural History & Animals","subjectEvidence":{"primarySubject":"Nature &