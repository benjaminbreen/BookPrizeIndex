alRenown":0.96,"controversy":0.92,"llmAffinity":0.99},"tags":{"craft":"structural-invention","evidence":"close-reading","stance":"wonder"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[{"name":"Michel Eyquem de Montaigne","confidence":0.99}],"centralPlaces":[],"argument":{"present":true,"statement":"Montaigne explored how to live through free-roaming reflections on his thoughts, experiences, relationships, losses, tastes, and the violence around him.","confidence":0.91},"academicOrientation":{"score":30,"confidence":0.9},"profileConfidence":0.96,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"3672e64b434e5d52ee4973f4caa267f64df303c347646784065e90d1c05c17b8","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Biography","secondarySubjects":["Society & Culture","History"],"confidence":"high","rationale":"The book primarily focuses on the life of Michel de Montaigne as a biography while also exploring cultural and historical themes related to his thoughts and writings.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"6b5549fb85b99b5fffa8696751b5528d3b08d7b058cb73d109cc1f61b041b8fc","summary":"How to get on well with people, how to deal with violence, how to adjust to losing someone you love? How to live? This question obsessed Renaissance nobleman Michel Eyquem de Montaigne (1533-92), who wrote free-roaming explorations of his thought and experience, unlike anything written before. Into these essays he put whatever was in his head: his tastes in wine and food, his childhood memories, the way his dog's ears twitched when it was dreaming, events in the appalling civil wars raging around him. The Essays was an instant bestseller, and over four hundred years later, readers still come to him in search of companionship, wisdom and entertainment - and in search of themselves. This first full biography of Montaigne in English for nearly fifty years relates the story of his life by way of the questions he posed and the answers he explored.","pageCount":403,"publicationYear":2011,"subjectCategories":[{"source":"google_books","scheme":"google_books_category","label":"Biography & Autobiography","sourceId":"source-google-books-summary-how-to-live-a-life-of-montaigne-in-one-question-and-twenty-attempts-at-an-answer-sarah-bakewell"}],"displaySummary":"This question obsessed Renaissance nobleman Michel Eyquem de Montaigne (1533-92), who wrote free-roaming explorations of his thought and experience, unlike anything written before. Into these essays he put whatever was in his head: his tastes in wine and food, his childhood memories, the way his dog's ears twitched when it was dreaming, events in the appalling civil wars raging around him. The Essays was an instant bestseller, and over four hundred years later, readers still come to him in search of companionship, wisdom and entertainment - and in search of themselves. This first full biography of Montaigne in English for nearly fifty years relates the story of his life by way of the questions he posed and the answers he explored.","primaryTopic":"Crime, Policing & Violence","subjectEvidence":{"primarySubject":"Biography","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Biography","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"Biography","mappedSubject":"Biography","score":8,"confidence":"high","note":"The book primarily focuses on the life of Michel de Montaigne as a biography while also exploring cultural and historical themes related to his thoughts and writings.","id":"subject-evidence-book-how-to-live-a-life-of-montaigne-in-one-question-and-twenty-attempts-at-an-answer-sarah-bakewell-1"},{"source":"google_books","scheme":"google_books_category","rawLabel":"Biography & Autobiography","mappedSubject":"Memoir & Autobiography","score":7,"confidence":"high","sourceId":"source-google-books-summary-how-to-live-a-life-of-montaigne-in-one-questio