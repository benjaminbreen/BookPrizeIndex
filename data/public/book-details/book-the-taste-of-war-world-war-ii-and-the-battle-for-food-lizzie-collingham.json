aderProfile":{"readerLevel":"crossover","narrativeScore":0,"accessibilityScore":0,"scholarlyScore":0,"traits":[],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":35,"criticalRenown":68,"controversy":18,"llmAffinity":81,"affinityResidual":5.19,"confidence":{"publicFame":0.92,"criticalRenown":0.9,"controversy":0.85,"llmAffinity":0.91},"tags":{"craft":"craft-of-explanation","evidence":"synthesis-of-scholarship","stance":"counterintuition"},"model":"gpt-5.6-luna","promptVersion":1},"summary":"A New York Times Notable Book of 2012 Food, and in particular the lack of it, was central to the experience of World War II. In this richly detailed and engaging history, Lizzie Collingham establishes how control of food and its production is crucial to total war. How were the imperial ambitions of Germany and Japan - ambitions which sowed the seeds of war - informed by a desire for self-sufficiency in food production? How was the outcome of the war affected by the decisions that the Allies and the Axis took over how to feed their troops? And how did the distinctive ideologies of the different combatant countries determine their attitudes towards those they had to feed? Tracing the interaction between food and strategy, on both the military and home fronts, this gripping, original account demonstrates how the issue of access to food was a driving force within Nazi policy and contributed to the decision to murder hundreds of thousands of 'useless eaters' in Europe. Focusing on both the winners and losers in the battle for food, The Taste of War brings to light the striking fact that war-related hunger and famine was not only caused by Nazi Germany and Imperial Japan, but was also the result of Allied mismanagement and neglect, particularly in India, Africa and China.","displaySummary":"In this richly detailed and engaging history, Lizzie Collingham establishes how control of food and its production is crucial to total war. How were the imperial ambitions of Germany and Japan - ambitions which sowed the seeds of war - informed by a desire for self-sufficiency in food production? How was the outcome of the war affected by the decisions that the Allies and the Axis took over how to feed their troops? And how did the distinctive ideologies of the different combatant countries determine their attitudes towards those they had to feed? Tracing the interaction between food and strategy, on both the military and home fronts, this gripping, original account demonstrates how the issue of access to food was a driving force within Nazi policy and contributed to the decision to murder hundreds of thousands of 'useless eaters' in Europe. Focusing on both the winners and losers in the battle for food, The Taste of War brings to light the striking fact that war-related hunger and famine was not only caused by Nazi Germany and Imperial Japan, but was also the result of Allied mismanagement and neglect, particularly in India, Africa and China.","primarySubject":"War & Military","primaryTopic":"World War II","subjectEvidence":{"primarySubject":"War & Military","confidence":"medium","method":"evidence_score","candidates":[{"subject":"War & Military","score":24,"evidenceCount":4},{"subject":"History","score":6,"evidenceCount":2},{"subject":"Society & Culture","score":5,"evidenceCount":1}],"evidence":[{"source":"open_library","scheme":"open_library_subject","rawLabel":"World War, 1939-1945","mappedSubject":"War & Military","score":6,"confidence":"high","sourceId":"source-open-library-the-taste-of-war-world-war-ii-and-the-battle-for-food-lizzie-collingham","id":"subject-evidence-book-the-taste-of-war-world-war-ii-and-the-battle-for-food-lizzie-collingham-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"War and society","mappedSubject":"War & Military","score":6,"confidence":"high","sourceId":"source-open-library-the-taste-of-war-world-war-ii-and-the-battle-for-food-lizzie-collingham","id":"subject-