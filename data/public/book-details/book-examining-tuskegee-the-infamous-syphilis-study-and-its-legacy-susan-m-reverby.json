nown":0.9,"controversy":0.88,"llmAffinity":0.94},"tags":{"craft":"craft-of-explanation","evidence":"archival-research","stance":"moral-seriousness"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[{"name":"Tuskegee","confidence":0.95},{"name":"Alabama","confidence":0.82}],"argument":{"present":true,"statement":"The study remains powerful in cultural and political life because its history exposes a complex knot of trust, betrayal, and belief.","confidence":0.88},"academicOrientation":{"score":68,"confidence":0.86},"profileConfidence":0.91,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"4368aebaaa5161d25dedbc4210b639709000aceb88923443d9e69613d129da2e","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Medicine & Public Health","secondarySubjects":["Race & Ethnicity","History"],"confidence":"high","rationale":"The book primarily analyzes the Tuskegee Syphilis Study within the frameworks of public health and medical ethics while also addressing issues of race and historical impact.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"d3bbc0e69ea0460306d142ce56925b33717115751756e91742bfd50125cd2a52","summary":"The forty year \"Tuskegee\" Syphilis Study has become the American metaphor for medical racism, government malfeasance, and physician arrogance. The subject of histories, films, rumors, and political slogans, it received an official federal apology from President Bill Clinton in a White House ceremony. The author offers an analysis of the notorious study of untreated syphilis, which took place in and around Tuskegee, Alabama, from the 1930s through the 1970s. The study involved hundreds of African American men, most of whom were told by doctors from the U.S. Public Health Service that they were being treated, not just watched, for their late stage syphilis. She examines the study and its aftermath from multiple perspectives to explain what happened and why the study has such power in our collective memory. She follows the study's repercussions in facts and fictions. She highlights the many uncertainties that dogged the study during its four decades and explores the newly available medical records. She uncovers the different ways it was understood by the men, their families, and health care professionals, ultimately revising conventional wisdom on the study. This work illuminates the events and aftermath of the study and sheds light on the complex knot of trust, betrayal, and belief that keeps this study alive in our cultural and political lives.","publicationYear":2009,"displaySummary":"The forty year \"Tuskegee\" Syphilis Study has become the American metaphor for medical racism, government malfeasance, and physician arrogance. The subject of histories, films, rumors, and political slogans, it received an official federal apology from President Bill Clinton in a White House ceremony. The author offers an analysis of the notorious study of untreated syphilis, which took place in and around Tuskegee, Alabama, from the 1930s through the 1970s. The study involved hundreds of African American men, most of whom were told by doctors from the U.S. Public Health Service that they were being treated, not just watched, for their late stage syphilis. She examines the study and its aftermath from multiple perspectives to explain what happened and why the study has such power in our collective memory. She follows the study's repercussions in facts and fictions. She highlights the many uncertainties that dogged the study during its four decades and explores the newly available medical records. She uncovers the different ways it was understood by the men, their families, and health care professionals, ultimately revising conventional wisdom on the study. This work illuminates the events and aftermath of the study and sheds light on the complex knot of trust, betrayal, and belief that keeps this study alive in our cultural and political lives.","primaryTopic":"Black History & Culture","subjectEvidence":{"primarySubject":"Medicine & Public Health","confidence":"high","method":"evidence_score","candidates":[{"subject":"Medicine & Public Health","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"Medicine & Public Health","mappedSubject":"Medicine & Public Health","score":8,"confidence":"high","note":"The book primarily analyzes the Tuskegee Syphilis Study within the frameworks of public health and medical ethics while also addressing issues of race and historical impact.","id":"subject-evidence-book-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"United States. Public Health Service","mappedSubject":"Medicine & Public Health","score":6,"confidence":"high","sourceId":"source-open-library-summary-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby","id":"subject-evidence-book-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby-4"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Human experimentation in medicine","mappedSubject":"Medicine & Public Health","score":6,"confidence":"high","sourceId":"source-open-library-summary-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby","id":"subject-evidence-book-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby-9"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Discrimination in medical care","mappedSubject":"Medicine & Public Health","score":6,"confidence":"high","sourceId":"source-open-library-summary-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby","id":"subject-evidence-book-examining-tuskegee-the-infamous-syphilis-study-and-its-legacy-susan-m-reverby-11"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"African americans, hea