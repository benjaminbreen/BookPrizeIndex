k-wikipedia-orwell-prize","source-imprint-normalization","source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok","source-open-library-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"],"thumbnailUrl":"https://covers.openlibrary.org/b/id/10482578-L.jpg","readerProfile":{"readerLevel":"crossover","narrativeScore":0.275,"accessibilityScore":0.198,"scholarlyScore":0,"traits":[{"id":"narrative","score":0.5,"confidence":"medium","evidence":["catalog text contains \"story of\"","catalog text contains \"true story\""]},{"id":"popular","score":0.22,"confidence":"low","evidence":["trade publisher signal: Farrar, Straus and Giroux / Macmillan"]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":58,"criticalRenown":73,"controversy":28,"llmAffinity":91,"affinityResidual":9.6,"confidence":{"publicFame":0.94,"criticalRenown":0.9,"controversy":0.82,"llmAffinity":0.98},"tags":{"craft":"narrative-drive","evidence":"reportage","stance":"moral-seriousness"},"model":"gpt-5.6-luna","promptVersion":1},"summary":"An incisive and compelling account of the case of 21-year-old Lucie Blackman, who stepped out into the vastness of Tokyo in the summer of 2000 and disappeared forever. The following winter, her dismembered remains were found buried in a seaside cave. The seven months in between had seen a massive search for the missing girl, involving Japanese policemen; British private detectives; Australian dowsers; and Lucie's desperate, but bitterly divided, parents. As the case unfolded, it drew the attention of prime ministers and sado-masochists, ambassadors and con-men, and reporters from across the world. Had Lucie been abducted by a religious cult, or snatched by human traffickers? Who was the mysterious man she had gone to meet? And what did her work, as a \"hostess\" in the notorious Roppongi district of Tokyo, really involve? *People Who Eat Darkness* is, by turns, a non-fiction thriller, a courtroom drama, and the biography of both a victim and a killer. It is the story of a young woman who fell prey to unspeakable evil, and of a loving family torn apart by grief. And it is a fascinating insight into one of the world's most baffling and mysterious societies, a light shone into dark corners of Japan that the rest of the world has never glimpsed before.","publicationYear":2011,"subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Young women","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Trials, litigation","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Investigation","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Murder","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Crimes against","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Women, crimes against","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Murder, japan","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"British, asia","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Homicide investigation","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Death and burial","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"},{"source":"open_library","scheme":"open_library_subject","label":"Murder victims' families","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok"}],"displaySummary":"An incisive and compelling account of the case of 21-year-old Lucie Blackman, who stepped out into the vastness of Tokyo in the summer of 2000 and disappeared forever. The following winter, her dismembered remains were found buried in a seaside cave. The seven months in between had seen a massive search for the missing girl, involving Japanese policemen; British private detectives; Australian dowsers; and Lucie's desperate, but bitterly divided, parents. As the case unfolded, it drew the attention of prime ministers and sado-masochists, ambassadors and con-men, and reporters from across the world. Had Lucie been abducted by a religious cult, or snatched by human traffickers? Who was the mysterious man she had gone to meet? And what did her work, as a \"hostess\" in the notorious Roppongi district of Tokyo, really involve? *People Who Eat Darkness* is, by turns, a non-fiction thriller, a courtroom drama, and the biography of both a victim and a killer. It is the story of a young woman who fell prey to unspeakable evil, and of a loving family torn apart by grief. And it is a fascinating insight into one of the world's most baffling and mysterious societies, a light shone into dark corners of Japan that the rest of the world has never glimpsed before.","primarySubject":"True Crime & Justice","primaryTopic":"World War II","subjectEvidence":{"primarySubject":"True Crime & Justice","confidence":"medium","method":"evidence_score","candidates":[{"subject":"True Crime & Justice","score":15,"evidenceCount":3},{"subject":"World History","score":5,"evidenceCount":1}],"evidence":[{"source":"open_library","scheme":"open_library_subject","rawLabel":"Trials, litigation","mappedSubject":"True Crime & Justice","score":5,"confidence":"high","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok","id":"subject-evidence-book-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Crimes against","mappedSubject":"True Crime & Justice","score":5,"confidence":"high","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok","id":"subject-evidence-book-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok-2"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Women, crimes against","mappedSubject":"True Crime & Justice","score":5,"confidence":"high","sourceId":"source-open-library-summary-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok","id":"subject-evidence-book-the-people-who-eat-darkness-the-true-story-of-a-young-woman-who-vanished-from-the-streets-of-tok-3"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"British, asia","mappedSubject":"World History","score":5,"confidence":"high","sourceId":"source-open-library-sum