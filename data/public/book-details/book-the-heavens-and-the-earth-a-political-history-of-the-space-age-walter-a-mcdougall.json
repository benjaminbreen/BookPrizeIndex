ds":["source-award-record-national-book-awards-nonfiction-wikipedia-national-book-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Award for Nonfiction","slug":"national-book-award-for-nonfiction"},"statusLabel":"Finalist"}],"imprint":"Basic Books","publisher":"Hachette Book Group","stats":{"bookId":"book-the-heavens-and-the-earth-a-political-history-of-the-space-age-walter-a-mcdougall","wins":1,"lists":2,"score":14,"majorWins":1,"normalWins":0,"majorShortlists":1,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":1,"co_winner":0,"finalist":1,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-the-heavens-and-the-earth-a-political-history-of-the-space-age-walter-a-mcdougall","pageTitle":"...The Heavens and the Earth","pageId":37869436,"wikidataId":"Q4545128","url":"https://en.wikipedia.org/wiki/...The_Heavens_and_the_Earth","revisionId":1332961421,"accessedAt":"2026-08-20T21:07:25.922Z","extract":"...the Heavens and the Earth: A Political History of the Space Age is a 1985 nonfiction book by American historian Walter A. McDougall, published by Basic Books. The book chronicles the politics of the Space Race, comparing the different approaches of the US and the USSR. ...the Heavens and the Earth was a finalist for the 1985 American Book Award and won the 1986 Pulitzer Prize for History. The work highlights the role of Soviet space achievements in spurring the US into mounting its own space efforts to prove the superiority of the American political and economic system, while at the same time adopting the technocratic methods of the Soviet Union in order to do so. McDougall defines technocracy as the state funding and managing technological change for its own purposes. He finds that President Eisenhower took a skeptical point of view on the idea of adopting technocracy in the United States, as he opposed committing the nation to a lunar landing and stated that the progress of state managed technology had contributed to a dangerous military–industrial complex in his farewell address. Yet Eisenhower fought against the tide, because by the time he left office the federal research and development budget had increased by 131 percent over the last five years. Gradually the idea of state managed technological progress went from being considered a violation of local freedoms to an accepted part of the federal government's responsibility. McDougall makes clear that he did not view this in positive terms, as this perceived responsibility trampled the traditional American value of limited government. Scholars have expressed disagreement with McDougall's perspective. Yet the amount of scholarly debate he generated illustrated his success in making a seminal contribution to the field of space history. NASA historian Roger Launius argues that this book is a \"classic study in the arena of space policy history\" and marked one of the key points in the maturation of spaceflight historiography upon its release in 1985.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/...The_Heavens_and_the_Earth","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"...the Heavens and the Earth: A Political History of the Space Age","author":"Walter A. McDougall","publicationDate":"1985 (Basic Books)","publicationPlace":"US","pages":"584","isbn":"978-1597401654","genre":"History"}},"sources":[{"id":"source-award-record-national-book-awards-nonfiction-wikipedia-national-book-award-for-nonfiction","label":"Wikipedia: National Book Award for Nonfiction","url":"https://en.wikipedia.org/wiki/National_Book_Award_for_Nonfiction","accessedAt":"2026-08-20T21:35:58.016Z","confidence":"secondary","field":"award","note":"Official archive URL: https://www.nationalbook.org/national-book-awards/search/ Imported table: National Book Award for Nonfiction winners and finalists, 2020–2029"},{"id":"source-award-record-pulitzer-history-wikipedia-pulitzer-prize-for-history","label":"Wikipedia: Pulitzer Prize for History","url":"https://en.wikipedia.org/wiki/Pulitzer_Prize_for_History","accessedAt":"2026-08-20T21:35:58.016Z","confidence":"secondary","field":"award","note":"Official category URL: https://www.pulitzer.org/prize-winners-by-category/220"},{"id":"source-open-library-the-heavens-and-the-earth-a-political-history-of-the-space-age-walter-a-mcdougall","label":"Open Library metadata for ...the Heavens and the Earth: A Political History of the Space Age","url":"https://openlibrary.org/books/OL7593491M","accessedAt":"2026-05-12T22:45:40.796Z","confidence":"catalog","field":"book"},{"id":"source-imprint-normalization","label":"Curated raw-publisher to imprint normalization","url":"","accessedAt":"2026-08-20T21:35:56.163Z","confidence":"manual","field":"publisher","note":"Curated mappings from raw catalog publisher strings to explicit imprint and parent-publisher records. Used by scripts/normalize-imprints.ts to generate sources/enrichment/imprints.normalized.json."},{"id":"source-wikipedia-the-heavens-and-the-earth-a-political-history-of-the-space-age-walter-a-mcdougall","label":"Wikipedia article for ...the Heavens and the Earth: A Political History of the Space Age","url":"https://en.wikipedia.org/wiki/...The_Heavens_and_the_Earth","accessedAt":"2026-08-20T21:07:25.922Z","confidence":"catalog","field":"book","note":"Matched by infobox_book:high; revision 1332961421."}]}
