lFigures":[],"centralPlaces":[{"name":"Vienna","confidence":0.78}],"argument":{"present":false,"statement":"","confidence":0},"academicOrientation":{"score":58,"confidence":0.45},"profileConfidence":0.62,"lowerConfidenceCandidates":{"argument":{"statement":"Austrian popular anti-Semitism was powerful enough that, after deportations began in 1941, Vienna crowds commonly approved, and Austria’s participation in Nazi killing operations reflected this popular sentiment.","confidence":0.52}},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"43c4b6f7d0215106bd952882ccb202e6e681eedca4913998e38b6b99bd94bbe0","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"\"Although Austrians comprised only 8 percent of the population of Hitler's Reich, they made up 14 percent of SS members and 40 percent of those involved in the Nazis' killing operations. This was no coincidence. Popular anti-Semitism was so powerful in Austria that once deportations of Jews began in 1941, the streets of Vienna were frequently lined with crowds of bystanders shouting their approval. Such scenes did not occur in Berlin.\". \"Exploring the convictions behind these phenomena, Evan Bukey offers a detailed examination of popular opinion in Hitler's native country after the Anschluss (annexation) of 1938. He uses evidence gathered in Europe and the United States to dissect the reactions, views, and conduct of disparate political and social groups - most notably the Austrian Nazi Party, the industrial working class, the Catholic Church, and the farming community.\"--BOOK JACKET.","subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Antisemitism","sourceId":"source-open-library-summary-hitler-s-austria-popular-sentiment-in-the-nazi-era-1938-1945-evan-burr-bukey"},{"source":"open_library","scheme":"open_library_subject","label":"National socialism","sourceId":"source-open-library-summary-hitler-s-austria-popular-sentiment-in-the-nazi-era-1938-1945-eva