umbnailUrl":"/book-covers/book-works-and-lives-the-anthropologist-as-author-clifford-geertz.jpg","readerProfile":{"readerLevel":"academic","narrativeScore":0,"accessibilityScore":0,"scholarlyScore":0.63,"traits":[{"id":"academic","score":0.59,"confidence":"medium","evidence":["catalog text contains \"methodolog\"","academic press signal: Stanford University Press / Stanford University Press"]},{"id":"essayistic","score":0.58,"confidence":"medium","evidence":["catalog text contains \"criticism\"","literature/criticism subject or topic","criticism award category"]},{"id":"scholarly","score":0.56,"confidence":"medium","evidence":["catalog text contains \"methodolog\"","academic press signal: Stanford University Press / Stanford University Press"]},{"id":"argument_driven","score":0.48,"confidence":"medium","evidence":["catalog text contains \"critique\"","catalog text contains \"interpretation\"","catalog text contains \"method\""]},{"id":"narrative","score":0.2,"confidence":"low","evidence":["catalog text contains \"quest\""]}],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":55,"criticalRenown":83,"controversy":42,"llmAffinity":86,"affinityResidual":5.33,"confidence":{"publicFame":0.97,"criticalRenown":0.98,"controversy":0.9,"llmAffinity":0.98},"tags":{"craft":"craft-of-explanation","evidence":"synthesis-of-scholarship","stance":"conceptual-strangeness"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":true,"statement":"Ethnography should be examined as a form of writing because attending to how ethnographic texts are constructed clarifies the field and teaches more perceptive reading.","confidence":0.96},"academicOrientation":{"score":76,"confidence":0.9},"profileConfidence":0.94,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"d642691199c7fb5718d9c87ccde7389aab33540710264b660be8133e17593f08","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Society & Culture","secondarySubjects":["Arts & Criticism"],"confidence":"high","rationale":"The book explores the nature of ethnographic writing and its relation to culture and society, with a focus on the authorial role in anthropology, making 'Society & Culture' the dominant frame.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"fc577fd979ff55b5cc628a46c705b41fd32967d4d8435ec62d8789dad1ac530a","summary":"The illusion that ethnography is a matter of sorting strange and irregular facts into familiar and orderly categoriesthis is magic, that is technologyhas long since been exploded. What it is instead, however, is less clear. That it might be a kind of writing, putting things to paper, has now and then occurred to those engaged in producing it, consuming it, or both. But the examination of it as such has been impeded by several considerations, none of them very reasonable. One of these, especially weighty among the producers, has been simply that it is an unanthropological sort of thing to do. What a proper ethnographer ought properly to be doing is going out to places, coming back with information about how people live there, and making that information available to the professional community in practical form, not lounging about in libraries reflecting on literary questions. Excessive concern, which in practice usually means any concern at all, with how ethnographic texts are constructed seems like an unhealthy self-absorptiontime wasting at best, hypochondriacal at worst. The advantage of shifting at least part of our attention from the fascinations of field work, which have held us so long in thrall, to those of writing is not only that this difficulty will become more clearly understood, but also that we shall learn to read with a more percipient eye.","displaySummary":"The illusion that ethnography is a matter of sorting strange and irregular facts into familiar and orderly categoriesthis is magic, that is technologyhas long since been exploded. What it is instead, however, is less clear. That it might be a kind of writing, putting things to paper, has now and then occurred to those engaged in producing it, consuming it, or both. But the examination of it as such has been impeded by several considerations, none of them very reasonable. One of these, especially weighty among the producers, has been simply that it is an unanthropological sort of thing to do. What a proper ethnographer ought properly to be doing is going out to places, coming back with information about how people live there, and making that information available to the professional community in practical form, not lounging about in libraries reflecting on literary questions. Excessive concern, which in practice usually means any concern at all, with how ethnographic texts are constructed seems like an unhealthy self-absorptiontime wasting at best, hypochondriacal at worst. The advantage of shifting at least part of our attention from the fascinations of field work, which have held us so long in thrall, to those of writing is not only that this difficulty will become more clearly understood, but also that we shall learn to read with a more percipient eye.","primaryTopic":"Literature & Writers","subjectEvidence":{"primarySubject":"Society & Culture","confidence":"high","method":"evidence_score","candidates":[{"subject":"Society & Culture","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"Society & Culture","mappedSubject":"Society & Culture","score":8,"confidence":"high","note":"The book explores the nature of ethnographic writing and its relation to culture and society, with a focus on the authorial role in anthropology, making 'Society & Culture' the dominant frame.","id":"subject-evidence-book-works-and-lives-the-anthropologist-as-author-clifford-geertz-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Art d'ecrire","mappedSubject":"Art