og_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":true,"statement":"Accidents of birth such as national origin, race, or gender still shape access to American citizenship rights, and white supremacy persists by adaptation and legislation, maintaining a caste system with conditional citizens pushed away.","confidence":0.61},"academicOrientation":{"score":35,"confidence":0.55},"profileConfidence":0.74,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"America","confidence":0.6}]},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"6d3b4de92a859c8e0c86153a6a887205383f4e1ce7b4a578526308408a895d54","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Race & Ethnicity","secondarySubjects":["Politics & Government","Memoir & Autobiography"],"confidence":"high","rationale":"The book primarily addresses the intersection of race, identity, and citizenship in America through the author's personal narrative, making Race & Ethnicity the dominant subject.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"9afe56ed1fb1c9cb9a11a0c4acfb9640db47bafcd2ae0eb80c1fc4f4f7df4665","summary":"\"The acclaimed, award-winning novelist--author of The Moor's Account and The Other Americans--now gives us a bracingly personal work of nonfiction that is concerned with the experiences of \"conditional citizens.\" What does it mean to be American? In this starkly illuminating and impassioned book, Pulitzer Prize Finalist Laila Lalami recounts her unlikely journey from Moroccan immigrant to U.S. citizen, using it as a starting point for her exploration of the rights, liberties, and protections that are traditionally associated with American citizenship. Tapping into history, politics, and literature, she elucidates how accidents of birth--such as national origin, race, or gender--that once determined the boundaries of Americanness still cast their shadows today. Throughout the book,