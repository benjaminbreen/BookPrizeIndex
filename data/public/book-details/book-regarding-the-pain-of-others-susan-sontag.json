 not images, may better foster reflection and empathy.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/Regarding_the_Pain_of_Others","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"Regarding the Pain of Others","author":"Susan Sontag","publisher":"Farrar, Straus and Giroux","publicationDate":"2003","publicationPlace":"United States","pages":"131","isbn":"978-0-374-24858-1","language":"English"},"publisherEvidenceId":"publisher-evidence-wikipedia-regarding-the-pain-of-others-susan-sontag"},"sources":[{"id":"source-award-record-nbcc-criticism-wikipedia-national-book-critics-circle-award-for-criticism","label":"Wikipedia: National Book Critics Circle Award for Criticism","url":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Criticism","accessedAt":"2026-08-15T17:37:11.749Z","confidence":"secondary","field":"award","note":"Official awards URL: https://www.bookcritics.org/awards/"},{"id":"source-cover-open-library-regarding-the-pain-of-others-susan-sontag","label":"Open Library cover for Regarding the Pain of Others","url":"https://openlibrary.org/works/OL496469W","accessedAt":"2026-07-15T06:36:18.409Z","confidence":"catalog","field":"book","note":"Cover ID 6256747 recovered from cached Open Library catalog metadata."},{"id":"source-open-library-summary-regarding-the-pain-of-others-susan-sontag","label":"Open Library summary metadata for Regarding the Pain of Others","url":"https://openlibrary.org/works/OL496469W","accessedAt":"2026-05-18T19:01:34.250Z","confidence":"catalog","field":"summary"},{"id":"source-open-library-regarding-the-pain-of-others-susan-sontag","label":"Open Library metadata for Regarding the Pain of Others","url":"https://openlibrary.org/books/OL9158643M","accessedAt":"2026-08-03T21:49:10.279Z","confidence":"catalog","field":"book"},{"id":"source-wikipedia-regarding-the-pain-of-others-susan-sontag"