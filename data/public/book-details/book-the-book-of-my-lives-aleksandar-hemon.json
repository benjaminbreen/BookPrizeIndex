calRenown":74,"controversy":5,"llmAffinity":86,"affinityResidual":5.33,"confidence":{"publicFame":0.9,"criticalRenown":0.88,"controversy":0.82,"llmAffinity":0.97},"tags":{"craft":"prose-style","evidence":"personal-experience","stance":"elegy"},"model":"gpt-5.6-luna","promptVersion":1},"experimentalSemanticProfile":{"centralFigures":[{"name":"Aleksandar Hemon","confidence":0.99}],"centralPlaces":[{"name":"Sarajevo","confidence":0.99},{"name":"Chicago","confidence":0.99}],"argument":{"present":true,"statement":"Displacement between Sarajevo and Chicago reshapes personal identity while intensifying the bonds of family and attachment to place.","confidence":0.86},"academicOrientation":{"score":32,"confidence":0.91},"profileConfidence":0.97,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"f21e5f7d74f045b785b6b84a022bc6502884d2fdfef9c9484d0eea3137a917a3","reviewStatus":"flagged","validationWarnings":["author_included_for_review: Aleksandar Hemon"]},"primarySubject":"Memoir & Autobiography","secondarySubjects":["Travel & Place","Society & Culture"],"confidence":"high","rationale":"The book primarily functions as a first-person account of the author's life experiences, particularly focusing on his backgrounds in Sarajevo and Chicago, while also exploring themes of place and cultural identity.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"ec4f46b47489f21cf17f91c042ef813568ddaf020a87060d75ccbd186ffcb723","summary":"\"Aleksandar Hemon's lives begin in Sarajevo, a small, blissful city where a young boy's life is consumed with street soccer with his casually multi-ethnic group of friends, resentment of his younger sister, and occasional trips abroad with his engineer-cum-beekeeper father, and a young man's life is about poking at the pretensions of the city's elders with American music, bad poetry, and slightly better journalism. And then there is Chicago -- war breaking out at home and the city fully under siege, the Hemon family fleeing Sarajevo (with their dog) and all they had ever known, applying for asylum, and Hemon himself starting his own family in this new city. And yet this is not really a memoir. Like Hemon's fiction, The Book of My Lives defies convention and expectation. It is a love-song to two different cities; it is a heartbreaking paean to the bonds of family; it is a stirring exhortation to go out and play soccer -- and not for the exercise. It is a book driven by passions but built on fierce intelligence, devastating experience, and sharp insight. And like the best narratives, it is a book that will leave you a different reader -- a different person, with a new way of looking at the world.","publicationYear":2013,"displaySummary":"And then there is Chicago -- war breaking out at home and the city fully under siege, the Hemon family fleeing Sarajevo (with their dog) and all they had ever known, applying for asylum, and Hemon himself starting his own family in this new city. And yet this is not really a memoir. Like Hemon's fiction, The Book of My Lives defies convention and expectation. It is a love-song to two different cities; it is a heartbreaking paean to the bonds of family; it is a stirring exhortation to go out and play soccer -- and not for the exercise. It is a book driven by passions but built on fierce intelligence, devastating experience, and sharp insight. And like the best narratives, it is a book that will leave you a different reader -- a different person, with a new way of looking at the world.","primaryTopic":"Group Biography","subjectEvidence":{"primarySubject":"Memoir & Autobiography","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Memoir & Autobiography","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"Memoir & Autobiography","mappedSubject":"Memoir & Autobiography","score":8,"confidence":"high","note":"The book primarily functions as a first-person account of the author's life experiences, particularly foc