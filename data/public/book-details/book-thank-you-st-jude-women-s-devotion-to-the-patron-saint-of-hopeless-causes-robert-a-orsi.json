s":[{"id":"academic","score":0.53,"confidence":"medium","evidence":["catalog text contains \"historians\"","academic press signal: Yale University Press / Yale University Press"]},{"id":"scholarly","score":0.48,"confidence":"medium","evidence":["catalog text contains \"historians\"","academic press signal: Yale University Press / Yale University Press"]},{"id":"accessible","score":0.18,"confidence":"low","evidence":["catalog text contains \"popular\""]},{"id":"reported","score":0.18,"confidence":"low","evidence":["catalog text contains \"interviews\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":false,"statement":"","confidence":0},"academicOrientation":{"score":55,"confidence":0.55},"profileConfidence":0.58,"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"52b12836c88255a43b37231e6bb27571e9a6e8fb57ddabb35c593672aa678541","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"St. Jude, patron saint of hopeless causes, is the most popular saint of the American Catholic laity, particularly among women. This fascinating book describes how the cult of St. Jude originated in 1929, traces the rise in Jude's popularity over the next decades, and investigates the circumstances that led so many Catholic women to feel hopeless and to turn to St. Jude for help. Robert A. Orsi tells us that the women who were drawn to St. Jude - daughters and granddaughters of immigrants from southern and eastern Europe and Ireland - were the first generations of Catholic women to make lives for themselves outside of their ethnic enclaves. Orsi explores the ambitions and dilemmas of these women as they dealt with the pressures of the Depression and the Second World War, made modern marriages for themselves, entered the workplace, took care of relatives in their old neighborhoods, and raised children in circumstances very different from those of their mothers and grandmothers. Drawing on testimonies written in the periodicals devoted to St. Jude and on interviews with women who felt their lives were changed by St. Jude's intervention, Orsi shows how devotion to St. Jude enabled these women to negotiate their way amid the conflicting expectations of their two cultures - American and Catholic.","subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Cult","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Catholic women","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Religious life","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Religious life and customs","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Cults","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Religiöses Leben","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Vrouwen","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-hopeless-causes-robert-a-orsi"},{"source":"open_library","scheme":"open_library_subject","label":"Heiligenverehrung","sourceId":"source-open-library-summary-thank-you-st-jude-women-s-devotion-to-the-patron-saint-of-