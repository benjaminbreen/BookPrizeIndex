{"book":{"id":"book-justice-in-kelly-country-the-story-of-the-cop-who-hunted-australia-s-most-notorious-bushrangers-","slug":"justice-in-kelly-country-the-story-of-the-cop-who-hunted-australia-s-most-notorious-bushrangers-","title":"Justice in Kelly Country: The story of the cop who hunted Australia’s most notorious bushrangers","authors":[{"id":"person-lachlan-strahan","name":"Lachlan Strahan"}],"isbn13":["9781038720610"],"subjects":["Nature & Environment"],"topics":["Climate, Weather & Disaster","Crime, Policing & Violence","Death, Memory & Commemoration","Essays & Cultural Criticism"],"centralFigures":["Anthony Strahan","Ned Kelly"],"links":{"amazon":"https://www.amazon.com/s?k=Justice%20in%20Kelly%20Country%3A%20The%20story%20of%20the%20cop%20who%20hunted%20Australia%E2%80%99s%20most%20notorious%20bushrangers%20Lachlan%20Strahan","bookshop":"https://bookshop.org/search?keywords=Justice%20in%20Kelly%20Country%3A%20The%20story%20of%20the%20cop%20who%20hunted%20Australia%E2%80%99s%20most%20notorious%20bushrangers%20Lachlan%20Strahan","indiebound":"https://www.indiebound.org/search/book?keys=Justice%20in%20Kelly%20Country%3A%20The%20story%20of%20the%20cop%20who%20hunted%20Australia%E2%80%99s%20most%20notorious%20bushrangers%20Lachlan%20Strahan","worldcat":"https://search.worldcat.org/search?q=Justice%20in%20Kelly%20Country%3A%20The%20story%20of%20the%20cop%20who%20hunted%20Australia%E2%80%99s%20most%20notorious%20bushrangers%20Lachlan%20Strahan","publisher":"https://books.google.com/books/about/Justice_in_Kelly_Country.html?hl=&id=QpS3zwEACAAJ"},"sourceIds":["source-award-record-australian-pmla-history-wikipedia-prime-minister-s-literary-awards","source-google-books-justice-in-kelly-country-the-story-of-the-cop-who-hunted-australia-s-most-notorious-bushrangers-","source-open-library-justice-in-kelly-country-the-story-of-the-cop-who-hunted-australia-s-most-notorious-bushrangers-"],"subjectCategories":[{"source":"google_books","scheme":"google_books_category","label":