ence.","thumbnailUrl":"https://covers.openlibrary.org/b/id/14543552-L.jpg","experimentalSemanticProfile":{"centralFigures":[{"name":"Shirley Hazzard","confidence":0.99}],"centralPlaces":[],"argument":{"present":true,"statement":"Shirley Hazzard’s formidable public presence was shaped by complex processes of self-fashioning across the course of her life.","confidence":0.86},"academicOrientation":{"score":38,"confidence":0.9},"profileConfidence":0.95,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"2a8b3431cca79fe601848ebf7f61a654acaa34aaf64abe71ee0286f978a7043b","reviewStatus":"unreviewed","validationWarnings":[]},"displaySummary":"This biography explores the distinctive times of Hazzard's life, from her youth and middle age to her widowhood and years of decline, tracing the complex processes of self-fashioning that lay beneath her formidable, beguiling presence.","primarySubject":"Biography","primaryTopic":"Essays & Cultural Criticism","subjectEvidence":{"primarySubject":"Biography","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Biography","score":30,"evidenceCount":5},{"subject":"Memoir & Autobiography","score":7,"evidenceCount":1},{"subject":"Society & Culture","score":5,"evidenceCount":1}],"evidence":[{"source":"google_books","scheme":"google_books_category","rawLabel":"Biography & Autobiography","mappedSubject":"Memoir & Autobiography","score":7,"confidence":"high","sourceId":"source-google-books-shirley-hazzard-a-writing-life-brigitta-olubas","id":"subject-evidence-book-shirley-hazzard-a-writing-life-brigitta-olubas-2"},{"source":"google_books","scheme":"google_books_category","rawLabel":"Biography & Autobiography","mappedSubject":"Biography","score":6,"confidence":"high","sourceId":"source-google-books-shirley-hazzard-a-writing-life-brigitta-olubas","id":"subject-evidence-book-shirley-hazzard-a-writing-life-brigitta-olubas-1"},{"source":"open_library","scheme":"open_library_subject","rawLabel":"Biography","mappedSubject":"Biogra