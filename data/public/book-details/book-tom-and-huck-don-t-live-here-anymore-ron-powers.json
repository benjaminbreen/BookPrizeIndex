d":"accessible","score":0.18,"confidence":"low","evidence":["catalog text contains \"popular\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[{"name":"Hannibal, Missouri","confidence":0.99}],"argument":{"present":true,"statement":"Present-day America romanticizes childhood in public rhetoric while brutalizing it through indifference, ignorance, and aggression.","confidence":0.91},"academicOrientation":{"score":28,"confidence":0.9},"profileConfidence":0.94,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"America","confidence":0.58}]},"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"8a83ed279741f6fa39bcaf6946c96c8fd831f7ebf8367daf4c97e60d77e0df88","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Society & Culture","secondarySubjects":["True Crime & Justice","American History"],"confidence":"high","rationale":"The book explores the social conditions and cultural perceptions surrounding childhood and violence in America, centering on a contemporary tragedy in a specific town, which qualifies it primarily under Society & Culture.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"78c3242cd242d84b309aa170e1250b748d9c736bf3e44d1d5d0c2445f870d351","summary":"\"Something had gone terribly wrong in Hannibal, Missouri. Within the space of six weeks, two killings - a manslaughter and then a murder - had taken place in the town that Mark Twain consecrated in his timeless classics about boyhood, the town that so proudly called itself \"America's Home Town.\" Both were committed by adolescents.\". \"Ron Powers felt compelled to revisit Hannibal. He had grown up there, and news of the crimes violated his faith in the town as an American sanctuary. The old \"world headquarters of childhood\" was not immune to the new national trend of violence by children. His hope was to find some explanation, some solace, some way of squaring these horrific tragedies with what he remembered about \"his\" Hannibal.\". \"Tom and Huck Don't Live Here Anymore illuminates the tortured paradox of childhood in present-day America: romanticized in public rhetoric but brutalized by countless acts of indifference, ignorance, and aggression. While no one can fully explain what makes children kill, Powers places the unthinkable squarely at the heart of America's story.\"--BOOK JACKET.","pageCount":336,"publicationYear":2001,"subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Social Situations And Conditions","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Sociology Of Children","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Current Affairs","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Sociology","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Politics/International Relations","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Children's Studies","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Popular Culture - Counter Culture","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Sociology - General","sourceId":"source-open-library-tom-and-huck-don-t-live-here-anymore-ron-powers"},{"source":"open_library","scheme":"open_library_subject","label":"Social Science / Children's Studies","sourceId":"source-open-library-tom-and-hu