ction"},"statusLabel":"Winner"},{"id":"appearance-between-the-world-and-me-ta-nehisi-coates-national-book-award-for-nonfiction-2015-winner","bookId":"book-between-the-world-and-me-ta-nehisi-coates","awardId":"award-national-book-award-for-nonfiction","awardEditionId":"edition-national-book-award-for-nonfiction-2015","year":2015,"status":"winner","originalStatus":"winner","statusRank":1,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Award_for_Nonfiction","sourceIds":["source-award-record-national-book-awards-nonfiction-wikipedia-national-book-award-for-nonfiction"],"award":{"awardType":"major_award","name":"National Book Award for Nonfiction","slug":"national-book-award-for-nonfiction"},"statusLabel":"Winner"},{"id":"appearance-between-the-world-and-me-ta-nehisi-coates-national-book-critics-circle-award-for-criticism-2015-finalist","bookId":"book-between-the-world-and-me-ta-nehisi-coates","awardId":"award-national-book-critics-circle-award-for-criticism","awardEditionId":"edition-national-book-critics-circle-award-for-criticism-2015","year":2015,"status":"finalist","originalStatus":"finalist","statusRank":2,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Criticism","sourceIds":["source-award-record-nbcc-criticism-wikipedia-national-book-critics-circle-award-for-criticism"],"award":{"awardType":"major_award","name":"National Book Critics Circle Award for Criticism","slug":"national-book-critics-circle-award-for-criticism"},"statusLabel":"Finalist"}],"imprint":"Spiegel & Grau","publisher":"Penguin Random House","stats":{"bookId":"book-between-the-world-and-me-ta-nehisi-coates","wins":3,"lists":7,"score":36,"majorWins":2,"normalWins":1,"majorShortlists":2,"normalShortlists":1,"majorLonglists":1,"normalLonglists":0,"statuses":{"winner":3,"co_winner":0,"finalist":3,"shortlist":0,"longlist":1,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-between-the-world-and-me-ta-nehisi-coates","pageTitle":"Between the World and Me","pageId":47228208,"wikidataId":"Q20669329","url":"https://en.wikipedia.org/wiki/Between_the_World_and_Me","revisionId":1354226167,"accessedAt":"2026-05-18T21:16:03.977Z","extract":"Between the World and Me is a 2015 nonfiction book written by American author Ta-Nehisi Coates and published by Spiegel & Grau. It was written by Coates as a letter to his then-teenage son about his perception of what the feelings, symbolism, and realities associated with being Black in the United States are. Coates recapitulates American history and explains to his son \"racist violence that has been woven into American culture.\" Coates draws from an abridged, autobiographical account of his youth in Baltimore, detailing his beliefs about the ways in which, to him, institutions like schools, the local police, and even \"the streets\" discipline, endanger, and threaten to \"disembody\" black men and women. The work takes structural and thematic inspiration from James Baldwin's 1963 epistolary book The Fire Next Time. Unlike Baldwin, however, Coates views white supremacy as \"an indestructible force, one that Black Americans will never evade or erase, but will always struggle against.\" Nobel laureate Toni Morrison praised the book, in that Coates \"filled an intellectual gap in succession to James Baldwin.\" Editors of The New York Times and The New Yorker described the book as \"exceptional\". The book won the 2015 National Book Award for Nonfiction and was a finalist for the 2016 Pulitzer Prize for General Nonfiction.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/Between_the_World_and_Me","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"Between the World and Me","author":"Ta-Nehisi Coates","publisher":"Spiegel & Grau","publicationDate":"July 2015","publicationPlace":"United States","pages":"176 }}","isbn":"978-0-8129-9354-7","language":"English","subject":"Autobiography, American history, race relations"},"publisherEvidenceId":"publisher-evidence-wikipedia-between-the-world-and-me-ta-nehisi-coates"},"sources":[{"id":"source-award-record-carnegie-nonfiction-ala-carnegie-medals-2016-annual-page","label":"ALA Carnegie Medals 2016 annual page","url":"https://www.ala.org/carnegie-medals/2016-winners","accessedAt":"2026-07-29T19:16:19.293Z","confidence":"official","field":"award","note":"Official awards URL: https://www.ala.org/rusa/awards/carnegie-medals"},{"id":"source-award-record-dayton-nonfiction-wikipedia-dayton-literary-peace-prize-nonfiction-table","label":"Wikipedia: Dayton Literary Peace Prize nonfiction table","url":"https://en.wikipedia.org/wiki/Dayton_Literary_Peace_Prize","accessedAt":"2026-07-29T19:16:19.293Z","confidence":"secondary","field":"award","note":"Official awards URL: https://www.daytonliterarypeaceprize.org/"},{"id":"source-award-record-kirkus-nonfiction-wikipedia-kirkus-prize","label":"Wikipedia: Kirkus Prize","url":"https://en.wikipedia.org/wiki/Kirkus_Prize","accessedAt":"2026-07-29T19:16:19.293Z","confidence":"secondary","field":"award","note":"Official awards URL: https://www.kirkusreviews.com/prize/"},{"id":"source-award-record-national-book-awards-nonfiction-wikipedia-national-book-award-for-nonfiction","label":"Wikipedia: National Book Award for Nonfiction","url":"https://en.wikipedia.org/wiki/National_Book_Award_for_Nonfiction","accessedAt":"2026-07-29T19:16:19.293Z","confidence":"secondary","field":"award","note":"Official archive URL: https://www.nationalbook.org/national-book-awards/search/ Imported table: National Book Award for Nonfiction winners and finalists, 2020–2029"},{"id":"source-award-record-nbcc-criticism-wikipedia-national-book-critics-circle-award-for-criticism","label":"Wikipedia: National Book Critics Circle Award for Criticism","url":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award