memoiristic","score":0.286,"confidence":"low","evidence":["catalog text contains \"memoir\"","catalog text contains \"memoir of\"","catalog text contains \"my\"","memoir/autobiography subject or topic","reduced because text appears to study narrative/biographical genres"]},{"id":"essayistic","score":0.2,"confidence":"low","evidence":["literature/criticism subject or topic"]},{"id":"experimental","score":0.2,"confidence":"low","evidence":["catalog text contains \"fragment\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[{"name":"Majdanek","confidence":0.98},{"name":"Latvia","confidence":0.95}],"argument":{"present":true,"statement":"The children's survival contradicts the logic and orderly rules of the plan designed to kill them.","confidence":0.94},"academicOrientation":{"score":25,"confidence":0.94},"profileConfidence":0.96,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"3ff27b9e4963a7fca7c33d283246e6ae449a689f67c68d75f60421d3c8b3a9c1","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"Memoir of a small boy who was separated from his family at the age of three or four-years-old after his father was killed during a round-up of Jews in Latvia, and was sent to the Majdanek death camp where he was discovered by Allied soldiers in 1945. I survived; quite a lot of other children did too. The plan was for us to die, not survive. According to the logic of the plan, and the orderly rules they devised to carry it out, we should have been dead. But we're alive. We're the living contradiction to logic and order. I'm not a poet or a writer. I can only try to use words to draw as exactly as possible what happened, what I saw; exactly the way my child's memory has held on to it; with no benefit of perspective or vanishing point. - p. 4-5.","subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Jewish children","sourceId":"source-open-library-summary-fragment