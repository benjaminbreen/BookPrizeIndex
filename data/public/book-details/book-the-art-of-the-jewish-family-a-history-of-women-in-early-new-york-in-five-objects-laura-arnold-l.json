xperimentalSemanticProfile":{"centralFigures":[{"name":"Hannah Louzada","confidence":0.9},{"name":"Reyna Levy Moses","confidence":0.9},{"name":"Sarah Brandon Moses","confidence":0.9}],"centralPlaces":[{"name":"New York","confidence":0.98}],"argument":{"present":true,"statement":"Material objects made for and by Jewish women reveal their diverse lives and agency as creators of Jewish identity beyond what male-authored texts preserve.","confidence":0.95},"academicOrientation":{"score":68,"confidence":0.82},"profileConfidence":0.94,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"f350c10baa8c00827fc0443992041e4bcb3d41109da18e817efb5fbb77c996f5","reviewStatus":"flagged","validationWarnings":["central_figures_hit_schema_cap"]},"summary":"In The Art of the Jewish Family, Laura Arnold Leibman examines five objects owned by a diverse group of Jewish women who all lived in New York in the years between 1750 and 1850: a letter from impoverished Hannah Louzada seeking assistance; a set of silver cups owned by Reyna Levy Moses; an ivory miniature owned by Sarah Brandon Moses, who was born enslaved and became one of the wealthiest Jewish women in New York; a book created by Sarah Ann Hays Mordecai; and a family silhouette owned by Rebbetzin Jane Symons Isaacs. These objects offer intimate and tangible views into the lives of Jewish American women from a range of statuses, beliefs, and lifestyles--both rich and poor, Sephardi and Ashkenazi, slaves and slaveowners. Each chapter creates a biography of a single woman through an object, offering a new methodology that looks past texts alone to material culture in order to further understand early Jewish American women's lives and restore their agency as creators of Jewish identity. While much of the available history was written by men, the objects that Leibman studies were made for and by Jewish women.","publicationYear":2020,"displaySummary":"In The Art of the Jewish Family, Laura Arnold Leibman examines five objects owned by a diverse group of Jewish women who all lived in New York in the years between 1750 and 1850: a letter from impoverished Hannah Louzada seeking assistance; a set of silver cups owned by Reyna Levy Moses; an ivory miniature owned by Sarah Brandon Moses, who was born enslaved and became in New York; a book created by Sarah Ann Hays Mordecai; and a family silhouette owned by Rebbetzin Jane Symons Isaacs. These objects offer intimate and tangible views into the lives of Jewish American women from a range of statuses, beliefs, and lifestyles--both rich and poor, Sephardi and Ashkenazi, slaves and slaveowners. Each chapter creates a biography of a single woman through an object, offering a new methodology that looks past texts alone to material culture in order to further understand early Jewish American women's lives and restore their agency as creators of Jewish identity. While much of the available history was written by men, the objects that Leibman studies were made for and by Jewish women.","primarySubject":"History","primaryTopic":"Art, Music & Performance","subjectEvidence":{"primarySubject":"History","confidence":"medium","method":"evidence_score","candidates":[{"subject":"History","score":3,"evidenceCount":1}],"evidence":[{"source":"google_books","scheme":"google_books_category","rawLabel":"History","mappedSubject":"History","score":3,"confidence":"medium","sourceId":"source-google-books-summary-the-art-of-the-jewish-family-a-history-of-women-in-early-new-york-in-five-objects-laura-arnold-l","id":"subject-evidence-book-the-art-of-the-jewish-family-a-history-of-women-in-early-new-york-in-five-objects-laura-arnold-l-1"},{"source":"award_category","rawLabel":"American History","mappedSubject":"American History","score":2,"confidence":"low","sourceId":"source-award-record-njba-american-jewish-history-wikipedia-list-of-winners-of-the-national-jewish-book-award","id":"subject-evidence-book-the-art-of-the-jewish-family-a-history-of-women-in-early-new-york-in-five-objec