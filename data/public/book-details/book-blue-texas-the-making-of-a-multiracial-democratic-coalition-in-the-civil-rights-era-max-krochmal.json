core":0,"scholarlyScore":0.196,"traits":[{"id":"narrative","score":0.48,"confidence":"medium","evidence":["catalog text contains \"story of\"","catalog text contains \"tells the story\""]},{"id":"scholarly","score":0.2,"confidence":"low","evidence":["catalog text contains \"historians\""]},{"id":"reported","score":0.18,"confidence":"low","evidence":["catalog text contains \"interviews\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":false,"statement":"","confidence":0},"academicOrientation":{"score":70,"confidence":0.46},"profileConfidence":0.57,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"Texas","confidence":0.55}]},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"8c19dfb0c905411b5d784600fe76dcd0c9f05729b07ae2df14ff6b8bef7a1fc3","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"This book is about the other Texas, not the state known for its cowboy conservatism, but a mid-twentieth-century hotbed of community organizing, liberal politics, and civil rights activism. Beginning in the 1930s, Max Krochmal tells the story of the decades-long struggle for democracy in Texas, when African American, Mexican American, and white labor and community activists gradually came together to empower the state's marginalized minorities. At the ballot box and in the streets, these diverse activists demanded not only integration but economic justice, labor rights, and real political power for all. Their efforts gave rise to the Democratic Coalition of the 1960s, a militant, multiracial alliance that would take on and eventually overthrow both Jim Crow and Juan Crow. Using rare archival sources and original oral history interviews, Krochmal reveals the often-overlooked democratic foundations and liberal tradition of one of our nation's most conservative states. Blue Texas remembers the many forgotten activists who, by crossing racial lines and building coalitions, democratized their cities and state to a degree that would have been unimaginable just a decade earlier--and it shows why their story still matters today.","subjectCategories":[{"source":"open_library","scheme":"open_library_subject","label":"Politics and government","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"Electoral coalitions","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"Minorities","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"Civil rights movements","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"Mexican Americans","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"African Americans","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"Political participation","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"source":"open_library","scheme":"open_library_subject","label":"Political activity","sourceId":"source-open-library-summary-blue-texas-the-making-of-a-multiracial-democratic-coalition-in-the-civil-rights-era-max-krochmal"},{"so