-elliott"]},"appearances":[{"id":"appearance-and-their-children-after-them-dale-maharidge-and-michael-williamson-pulitzer-prize-in-general-nonfiction-1990-winner","bookId":"book-and-their-children-after-them-dale-maharidge-and-michael-williamson","awardId":"award-pulitzer-prize-in-general-nonfiction","awardEditionId":"edition-pulitzer-prize-in-general-nonfiction-1990","year":1990,"status":"winner","originalStatus":"winner","statusRank":1,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/Pulitzer_Prize_for_General_Nonfiction","sourceIds":["source-award-record-pulitzer-general-nonfiction-wikipedia-pulitzer-prize-for-general-nonfiction"],"award":{"awardType":"major_award","name":"Pulitzer Prize in General Nonfiction","slug":"pulitzer-prize-in-general-nonfiction"},"statusLabel":"Winner"}],"imprint":"Pantheon","publisher":"Penguin Random House","stats":{"bookId":"book-and-their-children-after-them-dale-maharidge-and-michael-williamson","wins":1,"lists":1,"score":10,"majorWins":1,"normalWins":0,"majorShortlists":0,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":1,"co_winner":0,"finalist":0,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-and-their-children-after-them-dale-maharidge-and-michael-williamson","pageTitle":"And Their Children After Them (Maharidge and Williamson book)","pageId":16184939,"wikidataId":"Q4753368","url":"https://en.wikipedia.org/wiki/And_Their_Children_After_Them_(Maharidge_and_Williamson_book)","revisionId":1332961617,"accessedAt":"2026-08-20T21:07:25.922Z","extract":"And Their Children After Them (ISBN 9780394577661; subtitled The Legacy of Let Us Now Praise Famous Men: James Agee, Walker Evans, and the Rise and Fall of Cotton in the South), written by Dale Maharidge, photographed by Michael Williamson, and published by Pantheon Books in 1989, won the 1990 Pulitzer Prize for General Nonfiction. An updated 30th anniversary edition was published by Seven Stories Press in 2019. There is an initial overview of the white sharecropper families living during the Great Depression who were profiled in Let Us Now Praise Famous Men. The book goes on to follow these families into the current era. One finds out how the older generation died, and what happened to the children and grandchildren of the men and women in \"Let us Now Praise Famous Men.\" The author also discusses what happened to the average non-white sharecropper and their family through the years. He notes that at the time of publishing only one member of all the families covered in the earlier work had been able to go to college (and that that person was more than 30 years old at time of graduation), and that while the families are no longer dirt poor, they had not moved up in the social or economic ladder in a meaningful way.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/And_Their_Children_After_Them_(Maharidge_and_Williamson_book)","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"author":"Dale Maharidge","publisher":"Pantheon Books","publicationDate":"1989","isbn":"9780394577661"},"publisherEvidenceId":"publisher-evidence-wikipedia-and-their-children-after-them-dale-maharidge-and-michael-williamson"},"sources":[{"id":"source-award-record-pulitzer-general-nonfiction-wikipedia-pulitzer-prize-for-general-nonfiction","label":"Wikipedia: Pulitzer Prize for General Nonfiction","url":"https://en.wikipedia.org/wiki/Pulitzer_Prize_for_General_Nonfiction","accessedAt":"2026-08-20T21:35:58.016Z","confidence":"secondary","field":"award","note":"Official category URL: https://www.pulitzer.org/prize-winners-by-category/223"},{"id":"source-cover-open-library-and-their-children-after-them-dale-maharidge-and-michael-williamson","label":"Open Library cover for And Their Children after Them","url":"https://openlibrary.org/works/OL764