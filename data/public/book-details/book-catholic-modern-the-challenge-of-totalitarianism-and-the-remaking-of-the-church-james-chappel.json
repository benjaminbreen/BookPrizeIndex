{"book":{"id":"book-catholic-modern-the-challenge-of-totalitarianism-and-the-remaking-of-the-church-james-chappel","slug":"catholic-modern-the-challenge-of-totalitarianism-and-the-remaking-of-the-church-james-chappel","title":"Catholic Modern: The Challenge of Totalitarianism and the Remaking of the Church","authors":[{"id":"person-james-chappel","name":"James Chappel"}],"publisherId":"publisher-harvard-university-press","imprintId":"imprint-harvard-university-press","isbn13":["9780674985858"],"subjects":["Religion"],"topics":["Climate, Weather & Disaster","Death, Memory & Commemoration","Nationalism & Authoritarianism","Religion & Religious Movements"],"centralFigures":[],"links":{"amazon":"https://www.amazon.com/s?k=Catholic%20Modern%3A%20The%20Challenge%20of%20Totalitarianism%20and%20the%20Remaking%20of%20the%20Church%20James%20Chappel","bookshop":"https://bookshop.org/search?keywords=Catholic%20Modern%3A%20The%20Challenge%20of%20Totalitarianism%20and%20the%20Remaking%20of%20the%20Church%20James%20Chappel","indiebound":"https://www.indiebound.org/search/book?keys=Catholic%20Modern%3A%20The%20Challenge%20of%20Totalitarianism%20and%20the%20Remaking%20of%20the%20Church%20James%20Chappel","worldcat":"https://search.worldcat.org/search?q=Catholic%20Modern%3A%20The%20Challenge%20of%20Totalitarianism%20and%20the%20Remaking%20of%20the%20Church%20James%20Chappel","publisher":"https://play.google.com/store/books/details?id=W1NLDwAAQBAJ"},"sourceIds":["source-award-record-laura-shannon-european-studies-laura-shannon-prize-2020-official-shortlist","source-google-books-catholic-modern-the-challenge-of-totalitarianism-and-the-remaking-of-the-church-james-chappel","source-open-library-catholic-modern-the-challenge-of-totalitarianism-and-the-remaking-of-the-church-james-chappel","source-cover-open-library-catholic-modern-the-challenge-of-totalitarianism-and-the-remaking-of-the-church-james-chappel","source-imprint-normalization"],"subjectCategories":[{"source":"google_books","sc