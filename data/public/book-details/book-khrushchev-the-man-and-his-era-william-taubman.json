l":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Biography","sourceIds":["source-award-record-nbcc-biography-wikipedia-national-book-critics-circle-award-for-biography"],"award":{"awardType":"major_award","name":"National Book Critics Circle Award for Biography","slug":"national-book-critics-circle-award-for-biography"},"statusLabel":"Winner"}],"imprint":"W. W. Norton","publisher":"W. W. Norton & Company","stats":{"bookId":"book-khrushchev-the-man-and-his-era-william-taubman","wins":2,"lists":2,"score":20,"majorWins":2,"normalWins":0,"majorShortlists":0,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":2,"co_winner":0,"finalist":0,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-khrushchev-the-man-and-his-era-william-taubman","pageTitle":"Khrushchev: The Man and His Era","pageId":39478891,"wikidataId":"Q16852749","url":"https://en.wikipedia.org/wiki/Khrushchev%3A_The_Man_and_His_Era","revisionId":1334635301,"accessedAt":"2026-05-18T21:16:03.977Z","extract":"Khrushchev: The Man and His Era is a 2003 biography of Soviet leader Nikita Khrushchev. Written by William Taubman, the book is the first in-depth and comprehensive American biography of Khrushchev. Taubman was the recipient of the 2004 Pulitzer Prize for Biography or Autobiography, as well as the 2004 National Book Critics Circle Award. The author spent almost 20 years researching the life of Khrushchev in preparation to write the book. Extensive research was made possible through access to archives in Russia and Ukraine, which were opened to the public following the collapse of the Soviet Union. In addition to printed materials and documentation, he spent time engaging Khrushchev's children and extended relatives, resulting in over 70 personal interviews. Taubman presents a historical narrative and study of the life of Nikita Khrushchev, the Soviet leader who succeeded Joseph Stalin. The book concludes with Khrushchev's death on September 11, 1971.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/Khrushchev%3A_The_Man_and_His_Era","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"Khrushchev:; The Man and His Era","author":"William Taubman","publisher":"W. W. Norton & Company","publicationPlace":"United States","pages":"871","isbn":"978-0-393-32484-6","language":"English","subject":"Nikita Khrushchev","genre":"Nonfiction, biography"},"publisherEvidenceId":"publisher-evidence-wikipedia-khrushchev-the-man-and-his-era-william-taubman"},"sources":[{"id":"source-award-record-nbcc-biography-wikipedia-national-book-critics-circle-award-for-biography","label":"Wikipedia: National Book Critics Circle Award for Biography","url":"https://en.wikipedia.org/wiki/National_Book_Critics_Circle_Award_for_Biography","accessedAt":"2026-08-15T17:37:11.749Z","confidence":"secondary","field":"award","note":"Official awards URL: https://www.bookcritics.org/awards/"},{"id":"source-award-record-pulitzer-biography-or-autobiography-wikipedia-pulitzer-prize-for-biography","label":"Wikipedia: Pulitzer Prize for Biography","url":"https://en.wikipedia.org/wiki/Pulitzer_Prize_for_Biography","accessedAt":"2026-08-15T17:37:11.749Z","confidence":"secondary","field":"award","note":"Official category URL: https://www.pulitzer.org/prize-winners-by-category/222"},{"id":"source-open-library-khrushchev-the-man-and-his-era-william-taubman","label":"Open Library summary metadata for Khrushchev: The Man and His Era","url":"https://openlibrary.org/books/OL3561238M","accessedAt":"2026-05-15T22:08:23.081Z","confidence":"catalog","field":"summary"},{"id":"source-google-books-khrushchev-the-man-and-his-era-william-taubman","label":"Google Books metadata for Khrushchev: The Man and His Era","url":"https://books.google.com/books/about/Khrushchev.html?hl=&id=HyBYLL5V0