hy"},"statusLabel":"Finalist"}],"imprint":"W. W. Norton","publisher":"W. W. Norton & Company","stats":{"bookId":"book-the-hemingses-of-monticello-an-american-family-annette-gordon-reed","wins":5,"lists":6,"score":36,"majorWins":2,"normalWins":3,"majorShortlists":1,"normalShortlists":0,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":5,"co_winner":0,"finalist":1,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-the-hemingses-of-monticello-an-american-family-annette-gordon-reed","pageTitle":"The Hemingses of Monticello","pageId":19403788,"wikidataId":"Q7739360","url":"https://en.wikipedia.org/wiki/The_Hemingses_of_Monticello","revisionId":1332432429,"accessedAt":"2026-05-18T21:16:03.977Z","extract":"The Hemingses of Monticello: An American Family is a 2008 book by American historian Annette Gordon-Reed. It recounts the history of four generations of the African-American Hemings family, from their African and Virginia origins until the 1826 death of Thomas Jefferson, their master and the father of Sally Hemings' children. It is based on Gordon-Reed's study of legal records, diaries, farm books, letters, wills, newspapers, archives, and oral history. Gordon-Reed wanted readers to \"see slave people as individuals\" and to \"tell the story of this family in a way not done before\". Jefferson scholar Joseph Ellis has called the book \"the best study of a slave family ever written\". The book has won sixteen awards and was a finalist for the 2008 National Book Critics Circle Award in Biography and the 2009 Mark Lynton History Prize.","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/The_Hemingses_of_Monticello","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"The Hemingses of Monticello: An American Family","author":"Annette Gordon-Reed","publisher":"W. W. Nort