llar.jpg","libraryShelf":{"scheme":"lcc","callNumber":"DF562 .M55 2006","rawCallNumber":"DF562 .M55 2006","mainClass":"D","subclass":"DF","completeness":"full_call_number","confidence":"medium","matchedBy":"open_library_work_consensus","sourceId":"source-open-library-lcc-a-greek-roman-empire-power-and-belief-under-theodosius-ii-408-450-fergus-millar","sourceEditionId":"/books/OL9651108M","sourceWorkId":"/works/OL2751286W","sourceIsbn13":"9780520247031","sort":{"classLetters":"DF","classWholeNumber":562,"cutters":[{"letters":"M","decimalDigits":"55"}],"year":2006}},"readerProfile":{"readerLevel":"crossover","narrativeScore":0.007,"accessibilityScore":0,"scholarlyScore":0.356,"traits":[{"id":"academic","score":0.38,"confidence":"low","evidence":["academic press signal: University of California Press / University of California Press"]},{"id":"scholarly","score":0.28,"confidence":"low","evidence":["academic press signal: University of California Press / University of California Press"]},{"id":"narrative","score":0.2,"confidence":"low","evidence":["catalog text contains \"quest\""]},{"id":"accessible","score":0.18,"confidence":"low","evidence":["catalog text contains \"vivid\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[{"name":"Theodosius II","confidence":0.9}],"centralPlaces":[{"name":"Ephesus","confidence":0.75}],"argument":{"present":false,"statement":"","confidence":0},"academicOrientation":{"score":70,"confidence":0.45},"profileConfidence":0.78,"lowerConfidenceCandidates":{"centralPlaces":[{"name":"Constantinople","confidence":0.7}],"argument":{"statement":"Under Theodosius II, the eastern Roman system combined imperial governance and Church policy to promote Church unity through law and major councils, yielding largely successful frontier defense and internal coherence.","confidence":0.55}},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"2b45784f4415ec86828b4f938ac1cb8963f59ddaffcf077eaaf9212afd7457c6","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"History","secondarySubjects":["World History","Religion"],"confidence":"high","rationale":"The book predominantly explores the historical context of the Byzantine Empire during Theodosius II's reign, with a strong focus on government, church relations, and the historical development of power and belief, categorizing it as a work of history.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"620a8c73d25b6d732444ae998afee43ab089d63a3b25a72daed129435864470c","summary":"\"In the first half of the fifth century, the Latin-speaking part of the Roman Empire suffered vast losses of territory to barbarian invaders. But in the Greek-speaking half of the eastern Mediterranean, with its capital at Constantinople, there existed a stable and successful system, using Latin as its official language, but communicating with its subjects in Greek. This book takes an inside look at how this system worked in the long reign of the pious Christian Emperor Theodosius II (408-50), and analyzes its largely successful defense of its frontiers, its internal coherence, and its relations with its subjects, with a flow of demands and suggestions traveling up the hierarchy to the Emperor, and a long series of laws, often set out in elaborately self-justificatory detail, addressed by the Emperor, through his officials, to the people. Above all, this book focuses on the Imperial mission to promote the unity of the Church, the State's involvement in intensely debated doctrinal questions, and the calling by the Emperor of two major Church Councils at Ephesus, in 431 and 449. Between the Law codes and the acts of the Church Councils, the material illustrating the workings of government and the involvement of State and Church, is incomparably richer, more detailed, and more vivid than for any previous period.\"--Jacket.","publicationYear":2006,"subjectCategories":[{"source":"open_library","schem