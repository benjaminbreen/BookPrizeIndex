{"book":{"id":"book-with-malice-toward-some-treason-and-loyalty-in-the-civil-war-era-william-blair","slug":"with-malice-toward-some-treason-and-loyalty-in-the-civil-war-era-william-blair","title":"With Malice Toward Some: Treason and Loyalty in the Civil War Era","authors":[{"id":"person-william-blair","name":"William Blair"}],"isbn13":["9781469615462"],"subjects":["War & Military"],"topics":["American Civil War","Reconstruction","Democracy & Elections","Soldiers, Veterans & Combat Experience"],"centralFigures":[],"links":{"amazon":"https://www.amazon.com/s?k=With%20Malice%20Toward%20Some%3A%20Treason%20and%20Loyalty%20in%20the%20Civil%20War%20Era%20William%20Blair","bookshop":"https://bookshop.org/search?keywords=With%20Malice%20Toward%20Some%3A%20Treason%20and%20Loyalty%20in%20the%20Civil%20War%20Era%20William%20Blair","indiebound":"https://www.indiebound.org/search/book?keys=With%20Malice%20Toward%20Some%3A%20Treason%20and%20Loyalty%20in%20the%20Civil%20War%20Era%20William%20Blair","worldcat":"https://search.worldcat.org/search?q=With%20Malice%20Toward%20Some%3A%20Treason%20and%20Loyalty%20in%20the%20Civil%20War%20Era%20William%20Blair","publisher":"https://openlibrary.org/works/OL21068784W"},"sourceIds":["source-award-record-lincoln-prize-civil-war-era-gettysburg-college-previous-winners-of-the-gilder-lehrman-lincoln-pr","source-open-library-with-malice-toward-some-treason-and-loyalty-in-the-civil-war-era-william-blair","source-open-library-summary-with-malice-toward-some-treason-and-loyalty-in-the-civil-war-era-william-blair"],"publicationYear":2014,"thumbnailUrl":"https://covers.openlibrary.org/b/id/12195633-L.jpg","readerProfile":{"readerLevel":"crossover","narrativeScore":0,"accessibilityScore":0,"scholarlyScore":0,"traits":[],"method":"deterministic_catalog_heuristics_v1"},"renownProfile":{"knowsBook":true,"publicFame":18,"criticalRenown":62,"controversy":12,"llmAffinity":57,"affinityResidual":-14.68,"confidence":{"publicFame":0.88,"criticalRenown":0.8,"con