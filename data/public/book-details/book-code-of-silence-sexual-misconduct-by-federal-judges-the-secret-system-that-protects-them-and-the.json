e":0.114,"scholarlyScore":0,"traits":[{"id":"reported","score":0.7,"confidence":"medium","evidence":["catalog text contains \"reporter\"","catalog text contains \"reporting\"","catalog text contains \"firsthand\""]},{"id":"narrative","score":0.48,"confidence":"medium","evidence":["catalog text contains \"story of\"","catalog text contains \"tells the story\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[{"name":"Cathy McBroom","confidence":0.99},{"name":"Samuel Kent","confidence":0.98}],"centralPlaces":[{"name":"Galveston","confidence":0.92},{"name":"Texas","confidence":0.78}],"argument":{"present":true,"statement":"A secretive federal court system has tolerated or ignored complaints of corruption, sexism, and sexual misconduct, enabling accused judges to remain in power or retire with full pay.","confidence":0.98},"academicOrientation":{"score":32,"confidence":0.94},"profileConfidence":0.96,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"28b327753f4247f188abdd8da2d899cef5d27801acf61d8ebad1ef2415b0ceb8","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"Winner of the 2021 IRE Book Award Winner of the 2022 Texas Institute of Letters Carr P. Collins Award for Best Book of Nonfiction In the age of #MeToo, learn how brave whistleblowers have dared to lift the federal court’s veil of secrecy to expose powerful judges who appear to defy laws they have sworn to uphold Code of Silence tells the story of federal court employee Cathy McBroom, who had to flee her job as a case manager in Galveston, Texas, after enduring years of sexual harassment and assault by her boss—US District Judge Samuel Kent. Following a decade of firsthand reporting at the Houston Chronicle, investigative reporter Lise Olsen charts McBroom’s assault and the aftermath, when McBroom was thrust into the role of whistleblower to denounce a federal judge. What Olsen discovered by investigating McBroom’s story and other federal judicial misconduct matters nationwide was shocking. With the help of other federal judges, Kent was being protected by a secretive court system that has long tolerated or ignored complaints about corruption, sexism, and sexual misconduct—enabling him to remain in office for years. Other powerful judges accused of judicial misconduct were never investigated and remain in power or retired with full pay, such as US Circuit Judge Alex Kozinski and Kozinski’s mentee, Brett Kavanaugh.","pageCount":290,"publicationYear":2021,"subjectCategories":[{"source":"google_books","scheme":"google_books_category","label":"Social Science","sourceId":"source-google-books-summary-code-of-silence-sexual-misconduct-by-federal-judges-the-secret-system-that-protects-them-and-the"}],"displaySummary":"With the help of other federal judges, Kent was being protected by a secretive court system that has long tolerated or ignored complaints about corruption, sexism, and sexual misconduct—enabling him to remain in office for years. Other powerful judges accused of judicial misconduct were never investigated and remain in power or retired with full pay, such as US Circuit Judge Alex Kozinski and Kozinski’s mentee, Brett Kavanaugh.","primarySubject":"Society & Culture","primaryTopic":"Courts & Trials","subjectEvidence":{"primarySubject":"Society & Culture","confidence":"medium","method":"evidence_score","candidates":[{"subject":"Society & Culture","score":5,"evidenceCount":1}],"evidence":[{"source":"google_books","scheme":"google_books_category","rawLabel":"Social Science","mappedSubject":"Society & Culture","score":5,"confidence":"high","sourceId":"source-google-books-summary-code-of-silence-sexual-misconduct-by-federal-judges-the-secret-system-that-protects-them-and-the","id":"subject-evidence-book-code-of-silence-sexual-misconduct-by-federal-judges-the-secret-system-that-protects-them-and-the-1"},{"source":"keyword_classifier","rawLabel":"Gender & Sexuality","mappedSubject":"Gender & Sexuality","score