ilityScore":0,"scholarlyScore":0.356,"traits":[{"id":"essayistic","score":1,"confidence":"high","evidence":["catalog text contains \"essay\"","catalog text contains \"essays\"","catalog text contains \"criticism\"","literature/criticism subject or topic"]},{"id":"academic","score":0.38,"confidence":"low","evidence":["academic press signal: Oxford University Press / Oxford University Press"]},{"id":"scholarly","score":0.28,"confidence":"low","evidence":["academic press signal: Oxford University Press / Oxford University Press"]},{"id":"accessible","score":0.18,"confidence":"low","evidence":["catalog text contains \"popular\""]}],"method":"deterministic_catalog_heuristics_v1"},"experimentalSemanticProfile":{"centralFigures":[],"centralPlaces":[],"argument":{"present":false,"statement":"","confidence":0},"academicOrientation":{"score":60,"confidence":0.42},"profileConfidence":0.74,"lowerConfidenceCandidates":{"centralFigures":[{"name":"Aaron Copland","confidence":0.36}],"argument":{"statement":"By giving listeners tools to hear and analyze modern pop’s underlying musical concepts, Switched on Pop moves pop music from background noise to meaningful interpretation that matters to contemporary culture.","confidence":0.52}},"model":"gpt-5.4-nano-2026-03-17","promptVersion":8,"inputHash":"3c6aaa22b8f09eb6eeddc95a3d81dd5de82080cdbbe3448a5e3ef3d4cfa6ebc8","reviewStatus":"unreviewed","validationWarnings":[]},"primarySubject":"Arts & Criticism","secondarySubjects":[],"confidence":"high","rationale":"The book analyzes popular music and its cultural significance, firmly placing it within the domain of arts and criticism, specifically focusing on music.","method":"llm","model":"gpt-4o-mini","reviewStatus":"generated","inputHash":"e0ac33ee9694f3b21470d543759388d9c3090e67f23ad75af49ee90756580f9d","summary":"Pop music surrounds us - in our cars, over supermarket speakers, even when we are laid out at the dentist - but how often do we really hear what's playing? Switched on Pop is the book based on the eponymous podcast that has been hailed by NPR, Rolling Stone, The Guardian, and Entertainment Weekly for its witty and accessible analysis of Top 40 hits. Through close studies of sixteen modern classics, musicologist Nate Sloan and songwriter Charlie Harding shift pop from the background to the foreground, illuminating the essential musical concepts behind two decades of chart-topping songs. In 1939, Aaron Copland published What to Listen for in Music, the bestseller that made classical music approachable for generations of listeners. Eighty years later, Nate and Charlie update Copland's idea for a new audience and repertoire: 21st century pop, from Britney to Beyoncé, Outkast to Kendrick Lamar. Despite the importance of pop music in contemporary culture, most discourse only revolves around lyrics and celebrity. Switched on Pop gives readers the tools they need to interpret our modern soundtrack.","pageCount":225,"publicationYear":2019,"subjectCategories":[{"source":"google_books","scheme":"google_books_category","label":"Music","sourceId":"source-google-books-summary-switched-on-pop-how-popular-music-works-and-why-it-matters-nate-sloan-and-charlie-harding"}],"displaySummary":"In 1939, Aaron Copland published What to Listen for in Music, the bestseller that made classical music approachable for generations of listeners. Eighty years later, Nate and Charlie update Copland's idea for a new audience and repertoire: 21st century pop, from Britney to Beyoncé, Outkast to Kendrick Lamar. Despite the importance of pop music in contemporary culture, most discourse only revolves around lyrics and celebrity. Switched on Pop gives readers the tools they need to interpret our modern soundtrack.","primaryTopic":"Art, Music & Performance","subjectEvidence":{"primarySubject":"Arts & Criticism","confidence":"high","method":"evidence_score","candidates":[{"subject":"Arts & Criticism","score":8,"evidenceCount":1}],"evidence":[{"source":"llm_classifier","rawLabel":"