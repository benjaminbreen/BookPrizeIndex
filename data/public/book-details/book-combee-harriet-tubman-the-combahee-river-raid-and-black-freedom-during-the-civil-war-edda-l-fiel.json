pedia.org/wiki/Lincoln_Prize","sourceIds":["source-award-record-lincoln-prize-civil-war-era-wikipedia-lincoln-prize-recipients"],"award":{"awardType":"award","name":"Gilder Lehrman Lincoln Prize: Civil War Era","slug":"gilder-lehrman-lincoln-prize-civil-war-era"},"statusLabel":"Winner"},{"id":"appearance-combee-harriet-tubman-the-combahee-river-raid-and-black-freedom-during-the-civil-war-edda-l-fiel-mark-lynton-history-prize-2025-finalist","bookId":"book-combee-harriet-tubman-the-combahee-river-raid-and-black-freedom-during-the-civil-war-edda-l-fiel","awardId":"award-mark-lynton-history-prize","awardEditionId":"edition-mark-lynton-history-prize-2025","year":2025,"status":"finalist","originalStatus":"finalist","statusRank":2,"isTie":false,"sourceUrl":"https://en.wikipedia.org/wiki/Mark_Lynton_History_Prize","sourceIds":["source-award-record-mark-lynton-history-wikipedia-mark-lynton-history-prize"],"award":{"awardType":"award","name":"Mark Lynton History Prize","slug":"mark-lynton-history-prize"},"statusLabel":"Finalist"}],"imprint":"Oxford University Press","publisher":"Oxford University Press","stats":{"bookId":"book-combee-harriet-tubman-the-combahee-river-raid-and-black-freedom-during-the-civil-war-edda-l-fiel","wins":2,"lists":3,"score":16,"majorWins":1,"normalWins":1,"majorShortlists":0,"normalShortlists":1,"majorLonglists":0,"normalLonglists":0,"statuses":{"winner":1,"co_winner":1,"finalist":1,"shortlist":0,"longlist":0,"honorable_mention":0,"commended":0,"notable":0,"unknown":0}},"wikipediaEvidence":{"bookId":"book-combee-harriet-tubman-the-combahee-river-raid-and-black-freedom-during-the-civil-war-edda-l-fiel","pageTitle":"Combee: Harriet Tubman, the Combahee River Raid, and Black Freedom During the Civil War","pageId":80605793,"wikidataId":"Q135903048","url":"https://en.wikipedia.org/wiki/Combee%3A_Harriet_Tubman%2C_the_Combahee_River_Raid%2C_and_Black_Freedom_During_the_Civil_War","revisionId":1363285884,"accessedAt":"2026-08-20T21:07:25.922Z","extract":"Combee: Harriet Tubman, the Combahee River Raid, and Black Freedom During the Civil War is a 2024 book by American historian Edda L. Fields-Black published by Oxford University Press. Fields-Black documents Harriet Tubman's service during the American Civil War, particularly her role in the June 1–2, 1863, Combahee River Raid, a Union military operation that freed 756 enslaved people from rice plantations in South Carolina's Lowcountry. Fields-Black, descendant of a raid participant, draws on over 175 U.S. Civil War pension files to reconstruct the experiences of enslaved individuals who were freed in the raid and trace the emergence of Gullah Geechee culture. The book won the 2025 Pulitzer Prize for History (which it shared with Kathleen DuVal's Native Nations: A Millennium in North America), the Gilder Lehrman Lincoln Prize (2025), the Tom Watson Brown Book Award (2025), the George C. Rogers Jr. Award (2024), and the Marsha M. Greenlee History Award (2024).","matchedBy":"infobox_book:high","confidence":"high","attribution":{"label":"Wikipedia","url":"https://en.wikipedia.org/wiki/Combee%3A_Harriet_Tubman%2C_the_Combahee_River_Raid%2C_and_Black_Freedom_During_the_Civil_War","license":"CC BY-SA","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/"},"infobox":{"title":"Combee: Harriet Tubman, the Combahee River Raid, and Black Freedom during the Civil War","author":"Edda L. Fields-Black","publisher":"Oxford University Press","publicationDate":"2024","publicationPlace":"United States","isbn":"978-0-19-755279-7","language":"English","subject":"American Civil War, Harriet Tubman, Slavery in the United States, African-American history, Combahee River Raid","genre":"History"},"publisherEvidenceId":"publisher-evidence-wikipedia-combee-harriet-tubman-the-combahee-river-raid-and-black-freedom-during-the-civil-war-edda-l-fiel"},"sources":[{"id":"source-nonfiction-history-awards-by-imprint","label":"Nonfiction history awards by imprint seed workbook","url":"","accessed