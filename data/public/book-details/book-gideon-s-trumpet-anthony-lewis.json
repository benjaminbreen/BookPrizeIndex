igures":[{"name":"Clarence Earl Gideon","confidence":0.99}],"centralPlaces":[{"name":"U.S.","confidence":0.78}],"argument":{"present":true,"statement":"Every criminal defendant unable to afford a lawyer is entitled to legal representation, and recognizing this right transforms U.S. legal history.","confidence":0.97},"academicOrientation":{"score":25,"confidence":0.9},"profileConfidence":0.97,"model":"gpt-5.6-luna","promptVersion":8,"inputHash":"1dcad7cbf31dc480278a9188f3c10389f1d93ae6d23095dbf929b8f43ae2f011","reviewStatus":"unreviewed","validationWarnings":[]},"summary":"This is a true story about Clarence Earl Gideon, a semi-literate drifter, who is arrested for breaking into a pool room and for petty theft. When he asks the court to appoint a lawyer for his defense because he cannot afford one, his request is denied. Acting as his own lawyer, Gideon is convicted and sent to jail. While in prison, he begins a hand-written campaign directed to the U.S. Supreme Court, contending that every defendant is entitled to legal representation. The Court agrees to hear Gideon's case, and, in a landmark decision, rules in his favor. Gideon is given a new trial and is found innocent and U.S. legal history is changed forever.","publicationYear":1964,"displaySummary":"This is a true story about Clarence Earl Gideon, a semi-literate drifter, who is arrested for breaking into a pool room and for petty theft. When he asks the court to appoint a lawyer for his defense because he cannot afford one, his request is denied. Acting as his own lawyer, Gideon is convicted and sent to jail. While in prison, he begins a hand-written campaign directed to the U.S. Supreme Court, contending that every defendant is entitled to legal representation. The Court agrees to hear Gideon's case, and, in a landmark decision, rules in his favor. Gideon is given a new trial and is found innocent and U.S. legal history is changed forever.","primarySubject":"True Crime & Justice","primaryTopic":"Prisons & In