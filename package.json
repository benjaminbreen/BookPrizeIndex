{
  "name": "book-award-explorer",
  "version": "1.0.0",
  "description": "Static-first explorer for nonfiction book awards.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:build && next build",
    "start": "next start",
    "data:build": "tsx scripts/build-data.ts",
    "books:queue": "npm run data:build && tsx scripts/queue-book-enrichment.ts",
    "books:complete": "tsx scripts/enrich-books.ts",
    "books:enrich": "tsx scripts/enrich-books.ts",
    "subjects:enrich": "tsx scripts/enrich-subject-categories.ts",
    "topics:classify": "tsx scripts/classify-topics.ts",
    "data:topics": "npm run data:build && npm run topics:classify && npm run data:build",
    "data:enrich": "npm run data:build && npm run books:enrich && npm run data:build",
    "data:complete": "npm run data:build && npm run books:complete && npm run data:build",
    "data:subjects": "npm run data:build && npm run subjects:enrich && npm run data:build",
    "data:import:pulitzer": "tsx scripts/import-award-records/pulitzer.ts",
    "data:import:nba": "tsx scripts/import-award-records/national-book-awards.ts",
    "data:import:national-book-awards": "npm run data:import:nba",
    "data:import:nbcc": "tsx scripts/import-award-records/nbcc.ts",
    "data:import:carnegie": "tsx scripts/import-award-records/carnegie.ts",
    "data:import:kirkus": "tsx scripts/import-award-records/kirkus.ts",
    "data:import:baillie-gifford": "tsx scripts/import-award-records/baillie-gifford.ts",
    "data:import:cundill": "tsx scripts/import-award-records/cundill.ts",
    "data:import:pen-galbraith": "tsx scripts/import-award-records/pen-galbraith.ts",
    "data:import:latimes": "tsx scripts/import-award-records/latimes.ts",
    "data:import:prose": "tsx scripts/import-award-records/prose.ts",
    "data:import:wolfson": "tsx scripts/import-award-records/wolfson.ts",
    "data:validate:raw": "tsx scripts/import-award-records/validate.ts",
    "logos:imprints": "tsx scripts/fetch-imprint-logos.ts",
    "lint": "next lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.14.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
